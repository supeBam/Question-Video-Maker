{
  "name": "cn-literature-quiz-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "面向 Agent 工作流的多类型短视频生产项目，包含 Remotion 模板与媒体生产脚本",
  "scripts": {
    "dev": "remotion studio",
    "dev:data": "node scripts/quiz/studio-with-data.mjs",
    "studio": "remotion studio",
    "render:auto": "node scripts/quiz/render-with-cover.mjs --compose-tts",
    "render:manual": "node scripts/quiz/render-with-cover.mjs",
    "render": "node scripts/quiz/render-with-cover.mjs",
    "publish:prepare": "node scripts/publish/prepare.mjs",
    "still": "remotion still BurstQuiz out/preview.png",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "upgrade": "remotion upgrade",
    "demo:render": "node scripts/quiz/render-with-cover.mjs out/入门示例-第01期.mp4 --data=examples/questions-261105-1.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  }
}
