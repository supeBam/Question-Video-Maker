  "lines": [
    {"role": "开场", "text": "上回唠完西安，评论区炸了锅，"},
    {"role": "开场", "text": "全在问一个事："},
    {"role": "开场", "text": "西安唠明白了，那长安呢？"},
    {"role": "开场", "text": "长安为啥叫长安？这名字谁起的？"},
    {"role": "开场", "text": "十个老伙计，九个张嘴就来："},
    {"role": "开场", "text": "这还不简单，长治久安，图个吉利呗。"},
    {"role": "开场", "text": "这话，对。"},
    {"role": "开场", "text": "但还是——只说对了一半。"},

    {"role": "溯源", "text": "史书里头，白纸黑字写着："},
    {"role": "溯源", "text": "长安这俩字，头一回露面，"},
    {"role": "溯源", "text": "不是一座城，是一个人。"},
    {"role": "溯源", "text": "秦始皇的亲弟弟成皎，"},
    {"role": "溯源", "text": "封号就叫——长安君。"},
    {"role": "溯源", "text": "您没听错，早在秦国那会儿，"},
    {"role": "溯源", "text": "长安还只是咸阳城边上的一个乡。"},
    {"role": "溯源", "text": "谁也没想到，这个小小的乡名，"},
    {"role": "溯源", "text": "后来会变成天下第一城的名字。"},

    {"role": "定都", "text": "真正把长安捧上王座的，是汉高祖刘邦。"},
    {"role": "定都", "text": "当年他打下天下，本想把都城定在洛阳。"},
    {"role": "定都", "text": "一个叫娄敬的戍卒，拦着车队进言："},
    {"role": "定都", "text": "洛阳无险可守，关中才是金饭碗。"},
    {"role": "定都", "text": "张良一拍桌子：此言极是。"},
    {"role": "定都", "text": "刘邦当天就拍板，定都关中。"},
    {"role": "定都", "text": "两年后，萧何主持营建未央宫，"},
    {"role": "定都", "text": "新城就落在长安乡这块地上。"},
    {"role": "定都", "text": "后来贾谊在《治安策》里写下："},
    {"role": "定都", "text": "建久安之势，成长治之业。"},
    {"role": "定都", "text": "这八个字，算是给长安做了最好的注脚。"},

    {"role": "改名", "text": "可您知道吗？"},
    {"role": "改名", "text": "长安这个名字，中间还丢过一回。"},
    {"role": "改名", "text": "隋朝开国，杨坚在汉长安城东南，"},
    {"role": "改名", "text": "另起炉灶，建了一座新城。"},
    {"role": "改名", "text": "就因为他早年受封大兴郡公，"},
    {"role": "改名", "text": "新城便叫了——大兴城。"},
    {"role": "改名", "text": "堂堂长安，改名大兴。"},
    {"role": "改名", "text": "好在唐朝一立，头一件事，"},
    {"role": "改名", "text": "就是把名字改了回来。"},
    {"role": "改名", "text": "这一改，改出了贞观开元，"},
    {"role": "改名", "text": "改出了万国来朝。"},

    {"role": "升华", "text": "您细品这两个字的分量。"},
    {"role": "升华", "text": "打这以后，长安就不只是个地名了。"},
    {"role": "升华", "text": "它是李白笔下，长安一片月，万户捣衣声；"},
    {"role": "升华", "text": "是孟郊金榜题名，一日看尽长安花；"},
    {"role": "升华", "text": "是每一个中国人心里，"},
    {"role": "升华", "text": "太平盛世该有的样子。"},

    {"role": "求赞", "text": "讲到这，麻烦诸位老朋友抬抬手，"},
    {"role": "求赞", "text": "把屏幕底下那颗小红心按一下，"},
    {"role": "求赞", "text": "让更多爱听老故事的朋友，"},
    {"role": "求赞", "text": "也知道长安俩字的来龙去脉。"},

    {"role": "收尾", "text": "劳您在评论区写下四个字：长治久安。"},
    {"role": "收尾", "text": "写给这座城，也写给咱自个儿的日子。"},
    {"role": "收尾", "text": "您要是还有想弄明白的老地名，"},
    {"role": "收尾", "text": "评论区报个名——"},
    {"role": "收尾", "text": "下回，咱就唠您点的那座城。"},
    {"role": "收尾", "text": "劳您点个关注，咱们不走散。"}
  ]
}
