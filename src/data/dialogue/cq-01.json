  "lines": [
    {
      "role": "开场",
      "text": "今天想跟您唠一个事。"
    },
    {
      "role": "开场",
      "text": "重庆，山城雾都，咱们打小就熟。"
    },
    {
      "role": "开场",
      "text": "可要问重庆这俩字啥意思，"
    },
    {
      "role": "开场",
      "text": "为啥叫重庆，"
    },
    {
      "role": "开场",
      "text": "十个老伙计，九个得支支吾吾。"
    },
    {
      "role": "开场",
      "text": "多数人张口就来："
    },
    {
      "role": "开场",
      "text": "重庆嘛，是「重要」？"
    },
    {
      "role": "开场",
      "text": "还是「再次庆祝」？"
    },
    {
      "role": "开场",
      "text": "这话呀，都不沾边。"
    },
    {
      "role": "开场",
      "text": "史书里头，白纸黑字记着："
    },
    {
      "role": "白纸黑字",
      "text": "南宋淳熙十六年，"
    },
    {
      "role": "白纸黑字",
      "text": "有个皇帝叫赵惇。"
    },
    {
      "role": "白纸黑字",
      "text": "他先在这块地上封了恭王，"
    },
    {
      "role": "白纸黑字",
      "text": "没过多久，又登基当了皇帝。"
    },
    {
      "role": "白纸黑字",
      "text": "封王，是一喜，"
    },
    {
      "role": "白纸黑字",
      "text": "登基，又是一喜。"
    },
    {
      "role": "白纸黑字",
      "text": "皇帝自己说了，这叫双重喜庆。"
    },
    {
      "role": "白纸黑字",
      "text": "一道旨意下来，"
    },
    {
      "role": "白纸黑字",
      "text": "恭州，就升格成了重庆府。"
    },
    {
      "role": "白纸黑字",
      "text": "您听明白了吧，"
    },
    {
      "role": "白纸黑字",
      "text": "重庆，不是「很重要」的意思，"
    },
    {
      "role": "双重喜庆",
      "text": "是一个皇帝人生里最得意的两桩喜事，"
    },
    {
      "role": "双重喜庆",
      "text": "全压在这座城的名字上了。"
    },
    {
      "role": "双重喜庆",
      "text": "这一叫，就是八百多年。"
    },
    {
      "role": "双重喜庆",
      "text": "讲到这，先麻烦诸位老朋友抬抬手，"
    },
    {
      "role": "双重喜庆",
      "text": "把屏幕底下那颗小红心按一下，"
    },
    {
      "role": "双重喜庆",
      "text": "就当给咱们这座山城留个心意，"
    },
    {
      "role": "双重喜庆",
      "text": "也让更多爱听老故事的朋友，"
    },
    {
      "role": "双重喜庆",
      "text": "把这名字里头的喜事瞧个明白。"
    },
    {
      "role": "双重喜庆",
      "text": "闲话搁一边，接着往下说。"
    },
    {
      "role": "双重喜庆",
      "text": "其实这城的名字，改了好几茬。"
    },
    {
      "role": "双重喜庆",
      "text": "早先叫江州，"
    },
    {
      "role": "双重喜庆",
      "text": "后来嘉陵江古时候有个名字，"
    },
    {
      "role": "形胜",
      "text": "这座城也就跟着改了名字。"
    },
    {
      "role": "形胜",
      "text": "到了北宋，又改了一次名。"
    },
    {
      "role": "形胜",
      "text": "直到南宋这位赵惇皇帝，"
    },
    {
      "role": "形胜",
      "text": "封王又登基，一高兴，"
    },
    {
      "role": "形胜",
      "text": "才有了重庆。"
    },
    {
      "role": "形胜",
      "text": "所以您看，"
    },
    {
      "role": "形胜",
      "text": "重庆的「渝」，是嘉陵江给的，"
    },
    {
      "role": "形胜",
      "text": "重庆的「重庆」，是皇帝的双喜给的。"
    },
    {
      "role": "形胜",
      "text": "您再想想这座城的分量。"
    },
    {
      "role": "形胜",
      "text": "长江和嘉陵江在这儿交汇，"
    },
    {
      "role": "形胜",
      "text": "城是依山建的，楼是悬在崖上的，"
    },
    {
      "role": "形胜",
      "text": "上半城下半城，层层叠叠。"
    },
    {
      "role": "形胜",
      "text": "平地起雾的时候，"
    },
    {
      "role": "形胜",
      "text": "整座城就像浮在云里头。"
    },
    {
      "role": "形胜",
      "text": "可就是这么一个看着秀气的地方，"
    },
    {
      "role": "陪都",
      "text": "骨头比谁都硬。"
    },
    {
      "role": "陪都",
      "text": "抗战那些年，"
    },
    {
      "role": "陪都",
      "text": "国民政府搬到这儿，重庆成了战时首都，"
    },
    {
      "role": "陪都",
      "text": "日本人的炸弹，炸了五年多，"
    },
    {
      "role": "陪都",
      "text": "防空洞里的人出来，照样过日子，"
    },
    {
      "role": "陪都",
      "text": "这座山城，硬是没趴下。"
    },
    {
      "role": "陪都",
      "text": "您再往深里琢磨："
    },
    {
      "role": "陪都",
      "text": "从巴国到江州，从渝州到恭州，"
    },
    {
      "role": "陪都",
      "text": "再到今天的重庆，"
    },
    {
      "role": "陪都",
      "text": "三千年的老底子，"
    },
    {
      "role": "陪都",
      "text": "都压在这两江环抱的山城里。"
    },
    {
      "role": "陪都",
      "text": "可如今游客到了重庆，"
    },
    {
      "role": "陪都",
      "text": "张嘴就是那些吊脚楼、轻轨穿楼、"
    },
    {
      "role": "陪都",
      "text": "火锅、小面，"
    },
    {
      "role": "陪都",
      "text": "你要问他重庆这俩字啥意思，"
    },
    {
      "role": "今昔",
      "text": "为啥是「双重喜庆」，"
    },
    {
      "role": "今昔",
      "text": "十个里头九个答不上来。"
    },
    {
      "role": "今昔",
      "text": "这座城守了三千年，"
    },
    {
      "role": "今昔",
      "text": "守的是巴渝儿女的豪爽血性，"
    },
    {
      "role": "今昔",
      "text": "守的是抗战烽火里炸不垮的硬气。"
    },
    {
      "role": "今昔",
      "text": "这份家底，"
    },
    {
      "role": "今昔",
      "text": "不能在咱们手里断了线。"
    },
    {
      "role": "今昔",
      "text": "劳您在评论区写下四个字："
    },
    {
      "role": "今昔",
      "text": "重庆雄起。"
    },
    {
      "role": "今昔",
      "text": "写给这座火辣辣的山城，"
    },
    {
      "role": "今昔",
      "text": "也写给自己。"
    },
    {
      "role": "收尾",
      "text": "您要是还有自己家乡的老地名，"
    },
    {
      "role": "收尾",
      "text": "想弄明白来龙去脉，"
    },
    {
      "role": "收尾",
      "text": "也请在评论区报个名，"
    },
    {
      "role": "收尾",
      "text": "下回，咱就唠您点的那座城。"
    },
    {
      "role": "收尾",
      "text": "末了多说一句，"
    },
    {
      "role": "收尾",
      "text": "有些老底子里的讲究，"
    },
    {
      "role": "收尾",
      "text": "晚知道一天，"
    },
    {
      "role": "收尾",
      "text": "根就薄上那么一层。"
    },
    {
      "role": "收尾",
      "text": "一座城，两江交汇，"
    },
    {
      "role": "收尾",
      "text": "三千年文脉不断，"
    },
    {
      "role": "收尾",
      "text": "硬是把这山山水水，"
    },
    {
      "role": "收尾",
      "text": "养成了火辣辣又沉甸甸的一份家底。"
    },
    {
      "role": "收尾",
      "text": "劳您点个关注，咱们不走散。"
    },
    {
      "role": "收尾",
      "text": "下回接着给您唠，"
    },
    {
      "role": "收尾",
      "text": "您点的那座城。"
    }
  ]
}