  "lines": [
    {
      "role": "飞两遍",
      "text": "一九四九年十月一日，开国大典。"
    },
    {
      "role": "飞两遍",
      "text": "阅兵的时候，出了一件难事。"
    },
    {
      "role": "飞两遍",
      "text": "受阅的飞机，只有十几架。"
    },
    {
      "role": "飞两遍",
      "text": "太少了，撑不起场面。"
    },
    {
      "role": "飞两遍",
      "text": "怎么办。"
    },
    {
      "role": "飞两遍",
      "text": "总理说了一句，飞机不够，就飞两遍。"
    },
    {
      "role": "飞两遍",
      "text": "于是，打头的战斗机，飞过天安门之后。"
    },
    {
      "role": "飞两遍",
      "text": "绕个圈，又飞了一遍。"
    },
    {
      "role": "飞两遍",
      "text": "地上的百姓不知道。"
    },
    {
      "role": "飞两遍",
      "text": "他们仰头看着，一遍，又一遍。"
    },
    {
      "role": "飞两遍",
      "text": "都说，咱们的飞机，真多。"
    },
    {
      "role": "家底",
      "text": "您听听，这是一个刚成立的国，全部的家底。"
    },
    {
      "role": "家底",
      "text": "受阅的官兵，一万六千多人。"
    },
    {
      "role": "家底",
      "text": "走在最前头的，是海军的水兵。"
    },
    {
      "role": "家底",
      "text": "人民海军，那年春天，才刚刚成立。"
    },
    {
      "role": "家底",
      "text": "骑兵的战马，近两千匹。"
    },
    {
      "role": "家底",
      "text": "飞机十几架，还是东拼西凑的。"
    },
    {
      "role": "家底",
      "text": "有的是从敌人手里缴来的。"
    },
    {
      "role": "家底",
      "text": "有的飞行员，前天还在打仗。"
    },
    {
      "role": "家底",
      "text": "从天安门上飞过去的时候。"
    },
    {
      "role": "家底",
      "text": "座舱里，压着实弹。"
    },
    {
      "role": "家底",
      "text": "为什么。"
    },
    {
      "role": "家底",
      "text": "怕有人来捣乱，随时准备，迎上去。"
    },
    {
      "role": "家底",
      "text": "开国大典，是下午三点开始的。"
    },
    {
      "role": "家底",
      "text": "这个钟点，也是反复算过的。"
    },
    {
      "role": "家底",
      "text": "这一天，礼炮放了二十八响。"
    },
    {
      "role": "家底",
      "text": "二十八年，从建党，到建国。"
    },
    {
      "role": "家底",
      "text": "一穷二白的国，把腰杆挺起来了。"
    },
    {
      "role": "旗杆",
      "text": "大典的前一夜，出了一件险情。"
    },
    {
      "role": "旗杆",
      "text": "广场上那第一根电动旗杆。"
    },
    {
      "role": "旗杆",
      "text": "试旗的时候，出了故障。"
    },
    {
      "role": "旗杆",
      "text": "红旗升到顶，绞住了，下不来。"
    },
    {
      "role": "旗杆",
      "text": "明天一早就要用。"
    },
    {
      "role": "旗杆",
      "text": "一位工程师，叫林治远。"
    },
    {
      "role": "旗杆",
      "text": "带着工友，修了一整夜。"
    },
    {
      "role": "旗杆",
      "text": "爬上旗杆，一点一点地排障。"
    },
    {
      "role": "旗杆",
      "text": "天亮之前，修好了。"
    },
    {
      "role": "旗杆",
      "text": "第二天，毛主席按动电钮。"
    },
    {
      "role": "旗杆",
      "text": "第一面五星红旗，稳稳地升了起来。"
    },
    {
      "role": "旗杆",
      "text": "国歌奏响，礼炮齐鸣。"
    },
    {
      "role": "旗杆",
      "text": "没有人看得出，十几个小时之前。"
    },
    {
      "role": "旗杆",
      "text": "这根旗杆，刚刚从鬼门关回来。"
    },
    {
      "role": "人民万岁",
      "text": "广场上，三十万人。"
    },
    {
      "role": "人民万岁",
      "text": "队伍走过城楼的时候。"
    },
    {
      "role": "人民万岁",
      "text": "山呼海啸，喊的是，毛主席万岁。"
    },
    {
      "role": "人民万岁",
      "text": "城楼上的人，对着话筒回应。"
    },
    {
      "role": "人民万岁",
      "text": "喊的是，人民万岁。"
    },
    {
      "role": "人民万岁",
      "text": "您品一品这四个字。"
    },
    {
      "role": "人民万岁",
      "text": "几千年了，都是百姓喊皇上万岁。"
    },
    {
      "role": "人民万岁",
      "text": "从这一天起，调过来了。"
    },
    {
      "role": "人民万岁",
      "text": "是领头的这个人，喊人民万岁。"
    },
    {
      "role": "人民万岁",
      "text": "这一天，很多人哭着走完广场。"
    },
    {
      "role": "人民万岁",
      "text": "哭，是因为腰真的直起来了。"
    },
    {
      "role": "如今",
      "text": "七十多年过去。"
    },
    {
      "role": "如今",
      "text": "再阅兵的时候。"
    },
    {
      "role": "如今",
      "text": "天上的飞机，一排接着一排。"
    },
    {
      "role": "如今",
      "text": "预警机，加油机，歼击机。"
    },
    {
      "role": "如今",
      "text": "拖着彩烟，从天安门上过去。"
    },
    {
      "role": "如今",
      "text": "再也不用，飞两遍了。"
    },
    {
      "role": "如今",
      "text": "当年压着实弹上天的前辈。"
    },
    {
      "role": "如今",
      "text": "您要是能看见今天。"
    },
    {
      "role": "如今",
      "text": "咱们自己的大飞机，自己的航母。"
    },
    {
      "role": "如今",
      "text": "自己的空间站，自己的高铁。"
    },
    {
      "role": "如今",
      "text": "您出远门，给您认路的。"
    },
    {
      "role": "如今",
      "text": "是咱们自己的北斗。"
    },
    {
      "role": "如今",
      "text": "该多好。"
    },
    {
      "role": "如今",
      "text": "一穷二白的国，走到了世界前头。"
    },
    {
      "role": "如今",
      "text": "这盛世，真的，如你们所愿。"
    },
    {
      "role": "提问",
      "text": "说到这儿，我问您几件事。"
    },
    {
      "role": "提问",
      "text": "国庆，为什么是十月一日。"
    },
    {
      "role": "提问",
      "text": "这一天，是谁定的。"
    },
    {
      "role": "提问",
      "text": "阅兵，一共办了多少回。"
    },
    {
      "role": "提问",
      "text": "五星红旗，是谁画出来的。"
    },
    {
      "role": "提问",
      "text": "国歌的词和曲，是谁写的。"
    },
    {
      "role": "提问",
      "text": "国徽上头，都有些什么。"
    },
    {
      "role": "提问",
      "text": "还有，中国这两个字。"
    },
    {
      "role": "提问",
      "text": "最早，是刻在什么东西上的。"
    },
    {
      "role": "提问",
      "text": "您能答上来几个。"
    },
    {
      "role": "阅兵",
      "text": "先说国庆日。"
    },
    {
      "role": "阅兵",
      "text": "一九四九年十二月，中央人民政府定下。"
    },
    {
      "role": "阅兵",
      "text": "每年十月一日，是国庆日。"
    },
    {
      "role": "阅兵",
      "text": "再说阅兵。"
    },
    {
      "role": "阅兵",
      "text": "从开国那年起，年年都阅。"
    },
    {
      "role": "阅兵",
      "text": "一连，阅了十一年。"
    },
    {
      "role": "阅兵",
      "text": "后来，国家讲勤俭建国。"
    },
    {
      "role": "阅兵",
      "text": "阅兵，就停了下来。"
    },
    {
      "role": "阅兵",
      "text": "一停，二十多年。"
    },
    {
      "role": "阅兵",
      "text": "到一九八四年，才又恢复。"
    },
    {
      "role": "阅兵",
      "text": "您算一算，到今天。"
    },
    {
      "role": "阅兵",
      "text": "国庆大阅兵，一共办了十五次。"
    },
    {
      "role": "阅兵",
      "text": "逢十的年份，办得最隆重。"
    },
    {
      "role": "阅兵",
      "text": "这就叫，十年一大庆。"
    },
    {
      "role": "阅兵",
      "text": "每一回，都是这个国的一段年轮。"
    },
    {
      "role": "阅兵",
      "text": "今年的子孙，看的是飞机导弹。"
    },
    {
      "role": "阅兵",
      "text": "当年的父辈，看的是骡马大炮。"
    },
    {
      "role": "阅兵",
      "text": "同一个广场，两样的人间。"
    },
    {
      "role": "阅兵",
      "text": "今天看阅兵的孩子。"
    },
    {
      "role": "阅兵",
      "text": "已经不知道，什么叫飞两遍。"
    },
    {
      "role": "阅兵",
      "text": "这，就是答案。"
    },
    {
      "role": "国旗",
      "text": "筹备开国的时候，向全国征国旗的图。"
    },
    {
      "role": "国旗",
      "text": "一下子，来了近三千幅。"
    },
    {
      "role": "国旗",
      "text": "今天这面旗，一开始，并不起眼。"
    },
    {
      "role": "国旗",
      "text": "还落选了。"
    },
    {
      "role": "国旗",
      "text": "后来，有人从落选堆里，把它捡了回来。"
    },
    {
      "role": "国旗",
      "text": "一颗大星领着，四颗小星围着。"
    },
    {
      "role": "国旗",
      "text": "原稿里，大星当中，还有锤子镰刀。"
    },
    {
      "role": "国旗",
      "text": "定稿的时候，去掉了。"
    },
    {
      "role": "国旗",
      "text": "画它的人，不是大画家。"
    },
    {
      "role": "国旗",
      "text": "是一个做经济工作的职员。"
    },
    {
      "role": "国旗",
      "text": "上班下班，挤出工夫画出来的。"
    },
    {
      "role": "国旗",
      "text": "您看，这么重的一面旗。"
    },
    {
      "role": "国旗",
      "text": "就出自一个普通人的案头。"
    },
    {
      "role": "国旗",
      "text": "这个国，从一开始，就是人民的国。"
    },
    {
      "role": "国歌",
      "text": "国歌，原来是一部电影的主题歌。"
    },
    {
      "role": "国歌",
      "text": "写词的人，是田汉。"
    },
    {
      "role": "国歌",
      "text": "词写出来的时候，他正在牢里。"
    },
    {
      "role": "国歌",
      "text": "谱曲的人，叫聂耳。"
    },
    {
      "role": "国歌",
      "text": "拿到词的时候，才二十三岁。"
    },
    {
      "role": "国歌",
      "text": "他把曲子写好，寄回国内。"
    },
    {
      "role": "国歌",
      "text": "没过多久。"
    },
    {
      "role": "国歌",
      "text": "他在异国他乡的海里，再也没有上来。"
    },
    {
      "role": "国歌",
      "text": "一首歌，两个人。"
    },
    {
      "role": "国歌",
      "text": "一个把词写进牢墙，一个把命留在海上。"
    },
    {
      "role": "国歌",
      "text": "这首歌，先当了许多年的代国歌。"
    },
    {
      "role": "国歌",
      "text": "一九八二年，才正式定为国歌。"
    },
    {
      "role": "国歌",
      "text": "今天每次升旗，它一响起来。"
    },
    {
      "role": "国歌",
      "text": "请您站一站，听一听。"
    },
    {
      "role": "国歌",
      "text": "娃娃们，也跟着唱。"
    },
    {
      "role": "国歌",
      "text": "那不是歌，是两个人的命。"
    },
    {
      "role": "国徽",
      "text": "国徽上头，中间是天安门。"
    },
    {
      "role": "国徽",
      "text": "周围一圈，是谷穗和齿轮。"
    },
    {
      "role": "国徽",
      "text": "工人农民，都托着这个国。"
    },
    {
      "role": "国徽",
      "text": "金色和红色，是咱们最喜欢的两个颜色。"
    },
    {
      "role": "国徽",
      "text": "这枚国徽，是两拨读书人。"
    },
    {
      "role": "国徽",
      "text": "一笔一笔，打磨出来的。"
    },
    {
      "role": "国徽",
      "text": "再说中国这两个字。"
    },
    {
      "role": "国徽",
      "text": "您天天说，它最早写在什么地方。"
    },
    {
      "role": "国徽",
      "text": "一件三千多年前的青铜器上。"
    },
    {
      "role": "国徽",
      "text": "铭刻着四个字，宅兹中国。"
    },
    {
      "role": "国徽",
      "text": "意思是，在天下的中央，建都。"
    },
    {
      "role": "国徽",
      "text": "三千多年过去。"
    },
    {
      "role": "国徽",
      "text": "这两个字，咱们还在叫。"
    },
    {
      "role": "国徽",
      "text": "您说，这是不是一个奇迹。"
    },
    {
      "role": "过渡",
      "text": "放假这几天，孙子孙女凑过来问。"
    },
    {
      "role": "过渡",
      "text": "爷爷，国庆是什么。"
    },
    {
      "role": "过渡",
      "text": "您别只说，是放假。"
    },
    {
      "role": "过渡",
      "text": "您给他讲讲，飞机飞两遍的事。"
    },
    {
      "role": "过渡",
      "text": "讲讲旗杆前那一夜。"
    },
    {
      "role": "过渡",
      "text": "讲讲国旗是谁画的。"
    },
    {
      "role": "过渡",
      "text": "讲讲中国两个字，三千年了。"
    },
    {
      "role": "过渡",
      "text": "孩子眼睛里的光，不一样。"
    },
    {
      "role": "过渡",
      "text": "您讲得越多，孩子跟您越亲。"
    },
    {
      "role": "过渡",
      "text": "讲到动情的地方。"
    },
    {
      "role": "过渡",
      "text": "您自己的眼睛，也会热。"
    },
    {
      "role": "过渡",
      "text": "一个家，把国的故事传下去。"
    },
    {
      "role": "过渡",
      "text": "这个国，就永远年轻。"
    },
    {
      "role": "串烧",
      "text": "这样的故事，我随口再考您几个。"
    },
    {
      "role": "串烧",
      "text": "清明，既是节气，又是节日。"
    },
    {
      "role": "串烧",
      "text": "一年里头，独一份。"
    },
    {
      "role": "串烧",
      "text": "正月初一，古时候叫元旦。"
    },
    {
      "role": "串烧",
      "text": "现在的元旦，古时候就是过年。"
    },
    {
      "role": "串烧",
      "text": "人的虚岁，虚在什么地方。"
    },
    {
      "role": "串烧",
      "text": "虚在娘胎里，也算了一岁。"
    },
    {
      "role": "串烧",
      "text": "五福临门，都是什么福。"
    },
    {
      "role": "串烧",
      "text": "好多人贴了一辈子，说不上来。"
    },
    {
      "role": "串烧",
      "text": "五谷杂粮，都是什么谷。"
    },
    {
      "role": "串烧",
      "text": "稻，黍，稷，麦，菽。"
    },
    {
      "role": "串烧",
      "text": "这个稷，就是江山社稷的稷。"
    },
    {
      "role": "串烧",
      "text": "再考您一个，半斤八两。"
    },
    {
      "role": "串烧",
      "text": "为什么是八两。"
    },
    {
      "role": "串烧",
      "text": "古时候一斤，是十六两。"
    },
    {
      "role": "串烧",
      "text": "半斤，正好八两。"
    },
    {
      "role": "串烧",
      "text": "所以这个词，说的是两边一样沉。"
    },
    {
      "role": "串烧",
      "text": "还有，为什么叫买东西，不叫买南北。"
    },
    {
      "role": "串烧",
      "text": "东属木，西属金。"
    },
    {
      "role": "串烧",
      "text": "篮子装得下金木，装不下水火。"
    },
    {
      "role": "串烧",
      "text": "这些事，听着小。"
    },
    {
      "role": "串烧",
      "text": "凑到一块，就是一整个中国。"
    },
    {
      "role": "带货",
      "text": "这些故事，我都是从一本书里翻出来的。"
    },
    {
      "role": "带货",
      "text": "就是这本，一看就上瘾的中国文化一千问。"
    },
    {
      "role": "带货",
      "text": "王朝怎么更替，节气怎么流转。"
    },
    {
      "role": "带货",
      "text": "诗词怎么读，民俗怎么过。"
    },
    {
      "role": "带货",
      "text": "国旗国歌的来历，节日节气的讲究。"
    },
    {
      "role": "带货",
      "text": "老规矩什么意思，老称谓怎么个叫法。"
    },
    {
      "role": "带货",
      "text": "一千个问题，一问一答。"
    },
    {
      "role": "带货",
      "text": "都掰开揉碎，讲得明明白白。"
    },
    {
      "role": "带货",
      "text": "自己看，长见识。"
    },
    {
      "role": "带货",
      "text": "给孩子，立根基。"
    },
    {
      "role": "带货",
      "text": "送老人，解闷养心。"
    },
    {
      "role": "带货",
      "text": "老两口，还能你考我，我考你。"
    },
    {
      "role": "带货",
      "text": "出门等车，等人的空当，翻两页。"
    },
    {
      "role": "带货",
      "text": "比看手机，养眼睛。"
    },
    {
      "role": "带货",
      "text": "一天翻几页，饭桌上就有得讲。"
    },
    {
      "role": "带货",
      "text": "国庆这几天翻翻它。"
    },
    {
      "role": "带货",
      "text": "这个节，过得更有味道。"
    },
    {
      "role": "带货",
      "text": "厚厚的一本，够您讲一年。"
    },
    {
      "role": "带货",
      "text": "想要的朋友，点下方小黄车。"
    },
    {
      "role": "带货",
      "text": "进我橱窗，挑一挑。"
    },
    {
      "role": "互动",
      "text": "最后，如果您看到了这里。"
    },
    {
      "role": "互动",
      "text": "请在评论区，写下四个字，山河无恙。"
    },
    {
      "role": "互动",
      "text": "再祝咱们的祖国，生日快乐。"
    },
    {
      "role": "互动",
      "text": "今天，是祖国的生日。"
    },
    {
      "role": "互动",
      "text": "也是咱们每一个中国人，共同的节日。"
    },
    {
      "role": "互动",
      "text": "这盛世，他们没能看见。"
    },
    {
      "role": "互动",
      "text": "您写下的每一句祝福。"
    },
    {
      "role": "互动",
      "text": "都是替他们，多看一眼今天的中国。"
    }
  ]
}