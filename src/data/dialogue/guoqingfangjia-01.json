  "lines": [
    {
      "role": "开场",
      "text": "国庆为什么放假。"
    },
    {
      "role": "开场",
      "text": "您会说，这还用问吗。"
    },
    {
      "role": "开场",
      "text": "新中国成立了，举国同庆。"
    },
    {
      "role": "开场",
      "text": "我告诉大家，还有一层。"
    },
    {
      "role": "开场",
      "text": "这个假，是三千五百万人，用命换来的。"
    },
    {
      "role": "开场",
      "text": "他们没能过上这一天。"
    },
    {
      "role": "开场",
      "text": "您今天过的，是他们没等来的一天。"
    },
    {
      "role": "弯腰",
      "text": "这事儿，得从一八四零年说起。"
    },
    {
      "role": "弯腰",
      "text": "从那一年起，这国人的腰，是弯着的。"
    },
    {
      "role": "弯腰",
      "text": "炮台是别人的，租界是别人的。"
    },
    {
      "role": "弯腰",
      "text": "自家门口的公园，挂着牌子，不让中国人进。"
    },
    {
      "role": "弯腰",
      "text": "自己的土地上，中国人要给外人让路。"
    },
    {
      "role": "弯腰",
      "text": "一弯，弯了一百零九年。"
    },
    {
      "role": "弯腰",
      "text": "爷爷弯着，爹弯着。"
    },
    {
      "role": "弯腰",
      "text": "四代人，生下来，就弯着腰。"
    },
    {
      "role": "十四年",
      "text": "后来，日本人打来了。"
    },
    {
      "role": "十四年",
      "text": "咱们的祖辈，跟他们，打了整整十四年。"
    },
    {
      "role": "十四年",
      "text": "三千五百万人，伤亡。"
    },
    {
      "role": "十四年",
      "text": "您算一算，这是个什么数。"
    },
    {
      "role": "十四年",
      "text": "抵得上今天一座特大城市，从地图上，整个抹掉。"
    },
    {
      "role": "十四年",
      "text": "这三千五百万，不是数。"
    },
    {
      "role": "十四年",
      "text": "是三千五百万个，有名有姓的人。"
    },
    {
      "role": "十四年",
      "text": "是一个个家里的，爹，儿子，丈夫。"
    },
    {
      "role": "川军",
      "text": "七七事变之后，四川的兵出川了。"
    },
    {
      "role": "川军",
      "text": "前前后后，三百多万。"
    },
    {
      "role": "川军",
      "text": "穿着草鞋，徒步几千里，走上前线。"
    },
    {
      "role": "川军",
      "text": "有个后生要出川，他爹不送别的，送了一面旗。"
    },
    {
      "role": "川军",
      "text": "旗上一个大字，死。"
    },
    {
      "role": "川军",
      "text": "老人说，别守着我尽孝，到国难上尽忠去。"
    },
    {
      "role": "川军",
      "text": "受了伤，拿它裹伤。"
    },
    {
      "role": "川军",
      "text": "人没了，拿它裹身。"
    },
    {
      "role": "川军",
      "text": "您听听，这是一个爹，对儿子说的话。"
    },
    {
      "role": "川军",
      "text": "这面旗，今天还在。"
    },
    {
      "role": "川军",
      "text": "玻璃柜子里，叠得整整齐齐。"
    },
    {
      "role": "川军",
      "text": "什么叫无川不成军。"
    },
    {
      "role": "川军",
      "text": "不是四川人会打仗。"
    },
    {
      "role": "川军",
      "text": "是四川的爹，舍得把儿子，交给国。"
    },
    {
      "role": "桂军",
      "text": "淞沪会战，广西的兵也到了。"
    },
    {
      "role": "桂军",
      "text": "四万多人，赶了几千里路，赶到上海。"
    },
    {
      "role": "桂军",
      "text": "好多后生脚上的鞋，是娘熬夜纳的。"
    },
    {
      "role": "桂军",
      "text": "到了蕴藻浜，发起反击。"
    },
    {
      "role": "桂军",
      "text": "三天，倒下近两万。"
    },
    {
      "role": "桂军",
      "text": "两位旅长，同一天阵亡。"
    },
    {
      "role": "桂军",
      "text": "一位副师长，随后殉国。"
    },
    {
      "role": "桂军",
      "text": "广西兵有个老名号，叫狼兵，叫了两百多年。"
    },
    {
      "role": "桂军",
      "text": "这一仗打完，没有人再说，这个名号是白叫的。"
    },
    {
      "role": "桂军",
      "text": "可那些后生，也再没能，回到广西。"
    },
    {
      "role": "湘军",
      "text": "湖南的兵，更惨。"
    },
    {
      "role": "湘军",
      "text": "八个师，全投进了淞沪。"
    },
    {
      "role": "湘军",
      "text": "打到最后，番号没了。"
    },
    {
      "role": "湘军",
      "text": "什么叫番号没了。"
    },
    {
      "role": "湘军",
      "text": "就是这个部队的名，从军队的册子上，一笔划掉了。"
    },
    {
      "role": "湘军",
      "text": "人没了，名册也就合上了。"
    },
    {
      "role": "湘军",
      "text": "这一合，是多少个家，没了顶梁柱。"
    },
    {
      "role": "湘军",
      "text": "是多少个娘，再也等不到，儿子回来。"
    },
    {
      "role": "远征军",
      "text": "还有十万人，走得更远。"
    },
    {
      "role": "远征军",
      "text": "走出国境，去缅甸打仗。"
    },
    {
      "role": "远征军",
      "text": "他们是别人的爹，是别人的儿子，是别人的丈夫。"
    },
    {
      "role": "远征军",
      "text": "很多人，倒在了异国他乡。"
    },
    {
      "role": "远征军",
      "text": "倒下以后，连收尸的人都没有。"
    },
    {
      "role": "远征军",
      "text": "坟，都没有。"
    },
    {
      "role": "远征军",
      "text": "野人山的老林子里，下过雨。"
    },
    {
      "role": "远征军",
      "text": "土里，还能冲出钢盔来。"
    },
    {
      "role": "远征军",
      "text": "钢盔底下埋着的人，连个名字，都没留下。"
    },
    {
      "role": "南京",
      "text": "再说南京。"
    },
    {
      "role": "南京",
      "text": "一九三七年冬天，那座城，丢了。"
    },
    {
      "role": "南京",
      "text": "三十万同胞，惨死在屠刀之下。"
    },
    {
      "role": "南京",
      "text": "三十万，不是一个数。"
    },
    {
      "role": "南京",
      "text": "是三十万个名字，三十万个家。"
    },
    {
      "role": "南京",
      "text": "是三十万次，一个家的天，塌了。"
    },
    {
      "role": "南京",
      "text": "还有二十万被掳走的妇女。"
    },
    {
      "role": "南京",
      "text": "她们的大多数，没能活到道歉的那一天。"
    },
    {
      "role": "南京",
      "text": "记这笔账，不为记仇。"
    },
    {
      "role": "南京",
      "text": "是记住，落后，就要挨打受欺。"
    },
    {
      "role": "站起来",
      "text": "一九四五年八月十五日，广播里传出消息。"
    },
    {
      "role": "站起来",
      "text": "日本，无条件投降。"
    },
    {
      "role": "站起来",
      "text": "那一天，多少人抱着收音机，放声大哭。"
    },
    {
      "role": "站起来",
      "text": "九月二日，东京湾，密苏里号战列舰上。"
    },
    {
      "role": "站起来",
      "text": "日本政府和大本营的代表，签了降书。"
    },
    {
      "role": "站起来",
      "text": "四年之后，一九四九年十月一日。"
    },
    {
      "role": "站起来",
      "text": "天安门城楼上，那一声宣告。"
    },
    {
      "role": "站起来",
      "text": "中华人民共和国中央人民政府，今天成立了。"
    },
    {
      "role": "站起来",
      "text": "中国人民，从此站起来了。"
    },
    {
      "role": "站起来",
      "text": "从弯下腰，到直起腰。"
    },
    {
      "role": "站起来",
      "text": "一国人，整整走了，一百零九年。"
    },
    {
      "role": "点题",
      "text": "所以，国庆为什么放假。"
    },
    {
      "role": "点题",
      "text": "不只是为了歇，是为了记。"
    },
    {
      "role": "点题",
      "text": "您今天坐在家里，刷到这条视频。"
    },
    {
      "role": "点题",
      "text": "这份安生日子，是那三千五百万人，没过上的一天。"
    },
    {
      "role": "点题",
      "text": "放假这几天，抬头看见红旗的时候。"
    },
    {
      "role": "点题",
      "text": "心里把这些人，过一遍。"
    },
    {
      "role": "点题",
      "text": "穿草鞋的，送旗的，倒在异国的，没留下名的。"
    },
    {
      "role": "点题",
      "text": "再告诉身边的孩子。"
    },
    {
      "role": "点题",
      "text": "咱们的国庆，是怎么来的。"
    },
    {
      "role": "点题",
      "text": "这个假，才算没白放。"
    },
    {
      "role": "点题",
      "text": "如果您看到了这里。"
    },
    {
      "role": "点题",
      "text": "请在评论区，写下四个字，山河无恙。"
    },
    {
      "role": "点题",
      "text": "这盛世，他们没能看见。"
    },
    {
      "role": "点题",
      "text": "您多写一句祝福。"
    },
    {
      "role": "点题",
      "text": "就是替他们，多看一眼今天的中国。"
    }
  ]
}