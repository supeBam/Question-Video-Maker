 "lines": [
  {
   "role": "开场",
   "text": "今天想跟您唠一个事。"
  },
  {
   "role": "开场",
   "text": "万里长城，东起山海关，西到嘉峪关，咱们打小就会背。"
  },
  {
   "role": "开场",
   "text": "可要问嘉峪关这三个字啥意思，为啥叫嘉峪关，十个老伙计，九个得挠头。"
  },
  {
   "role": "开场",
   "text": "多数人张口就来，这还不简单，嘉峪关口嘛，险要的地方，名字肯定也霸气。"
  },
  {
   "role": "开场",
   "text": "错了，还错得挺有意思。"
  },
  {
   "role": "开场",
   "text": "这三个字，跟打仗一点关系都没有。"
  },
  {
   "role": "揭底",
   "text": "史书里写得明白，嘉峪关的关城，建在一座山的西麓，山叫嘉峪山。"
  },
  {
   "role": "揭底",
   "text": "嘉，是美好的意思。"
  },
  {
   "role": "揭底",
   "text": "峪，是山谷的意思。"
  },
  {
   "role": "揭底",
   "text": "嘉峪关三个字连起来，就是美丽的山谷里那座关。"
  },
  {
   "role": "揭底",
   "text": "您没听错，天下第一雄关，名字其实是在夸风景。"
  },
  {
   "role": "求赞",
   "text": "讲到这，先麻烦诸位老朋友抬抬手，把屏幕底下那颗小红心按一下。"
  },
  {
   "role": "求赞",
   "text": "就当给这座守在戈壁滩上六百多年的老关城，留个心意。"
  },
  {
   "role": "求赞",
   "text": "也让更多爱听老故事的朋友，把这名字里头的讲究瞧个明白。"
  },
  {
   "role": "建关",
   "text": "闲话搁一边，接着往下盘。"
  },
  {
   "role": "建关",
   "text": "明朝洪武五年，征虏大将军冯胜率军平定河西。"
  },
  {
   "role": "建关",
   "text": "一路走一路看，走到酒泉西边，他站住了。"
  },
  {
   "role": "建关",
   "text": "南边是祁连山的文殊山，北边是连绵的黑山，两山之间夹着一条窄窄的通道。"
  },
  {
   "role": "建关",
   "text": "这里就是河西走廊的咽喉，出了这道口，就是西域。"
  },
  {
   "role": "建关",
   "text": "冯胜一拍板，放弃敦煌不守，就在这儿建关。"
  },
  {
   "role": "建关",
   "text": "关城建在嘉峪山下，就叫嘉峪关。"
  },
  {
   "role": "建关",
   "text": "一座关，就这么把大明王朝的西边大门，给锁上了。"
  },
  {
   "role": "形胜",
   "text": "您再琢磨这个名字的反差。"
  },
  {
   "role": "形胜",
   "text": "边关是做什么的，是挡铁骑，御外敌的，刀口舔血的地方。"
  },
  {
   "role": "形胜",
   "text": "可咱们的老祖宗给它起名，不叫什么镇西关，也不叫什么定远关。"
  },
  {
   "role": "形胜",
   "text": "偏偏用了两个字，一个嘉，一个峪，山美水美，一片太平气。"
  },
  {
   "role": "形胜",
   "text": "这就是中国人的讲究，越是金戈铁马的地方，名字越往太平了起。"
  },
  {
   "role": "形胜",
   "text": "心里盼的是什么，名字里就藏着什么。"
  },
  {
   "role": "今昔",
   "text": "六百多年过去，这道关还站在戈壁滩上。"
  },
  {
   "role": "今昔",
   "text": "黄土筑的城墙，风吹日晒，愣是没倒。"
  },
  {
   "role": "今昔",
   "text": "当年从这儿出关的，有戍边的将士，有丝绸之路上的驼队，有贬谪的文人。"
  },
  {
   "role": "今昔",
   "text": "林则徐当年路过，写下了严关百尺界天西的名句。"
  },
  {
   "role": "今昔",
   "text": "一座关，把多少人的家国心事，都装进了名字里。"
  },
  {
   "role": "收尾",
   "text": "劳您在评论区写下四个字，雄关永固。"
  },
  {
   "role": "收尾",
   "text": "写给这座守了大明西边大门的老关城，也写给咱自己的日子。"
  },
  {
   "role": "收尾",
   "text": "您要是还有自己家乡的老地名，想弄明白来龙去脉，也请在评论区报个名。"
  },
  {
   "role": "收尾",
   "text": "下回，咱就唠您点的那座城。"
  },
  {
   "role": "收尾",
   "text": "末了多说一句，有些老底子里的讲究，晚知道一天，根就薄上那么一层。"
  },
  {
   "role": "收尾",
   "text": "最刚的关，用了最柔的名字，这一刚一柔之间，就是中国人骨子里的浪漫。"
  },
  {
   "role": "收尾",
   "text": "以史为鉴，可以知兴替。"
  },
  {
   "role": "收尾",
   "text": "劳您点个关注，咱们不走散。"
  },
  {
   "role": "收尾",
   "text": "下回接着给您唠，您点的那座城。"
  }
 ]
}