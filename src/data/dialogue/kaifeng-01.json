 "lines": [
  {
   "role": "开场",
   "text": "今天想跟您唠一个事。"
  },
  {
   "role": "开场",
   "text": "今早唠了北京，里头提了一句，明朝第一个叫北京的城市，其实是开封。"
  },
  {
   "role": "开场",
   "text": "好些老朋友就问了，那开封这俩字又是啥意思？"
  },
  {
   "role": "开场",
   "text": "开，是打开。封，是封闭。"
  },
  {
   "role": "开场",
   "text": "一个开，一个封，拧着劲的两个字，怎么凑成了一座城？"
  },
  {
   "role": "开场",
   "text": "十个老伙计，九个说不上来。"
  },
  {
   "role": "揭底",
   "text": "其实开封原来不叫开封，叫启封。"
  },
  {
   "role": "揭底",
   "text": "春秋那会儿，郑庄公在这儿筑了一座城，取的是启拓封疆的意思，开拓疆土，多气派。"
  },
  {
   "role": "揭底",
   "text": "后来到了汉朝，出事了。"
  },
  {
   "role": "揭底",
   "text": "汉景帝即位，这位皇帝名叫刘启。"
  },
  {
   "role": "揭底",
   "text": "皇帝的名字，天下人都要避讳，带启字的地名不能叫了。"
  },
  {
   "role": "揭底",
   "text": "启封怎么办？把启字换成意思相近的开字。"
  },
  {
   "role": "揭底",
   "text": "启封，就这么成了开封。"
  },
  {
   "role": "揭底",
   "text": "一座城，给皇帝的名字让了路，这一让，就是两千多年。"
  },
  {
   "role": "求赞",
   "text": "讲到这，先麻烦诸位老朋友抬抬手，把屏幕底下那颗小红心按一下。"
  },
  {
   "role": "求赞",
   "text": "就当给这座八朝古都留个心意。"
  },
  {
   "role": "求赞",
   "text": "也让更多爱听老故事的朋友，把这名字里头的讲究瞧个明白。"
  },
  {
   "role": "纵深",
   "text": "闲话搁一边，接着往下盘。"
  },
  {
   "role": "纵深",
   "text": "这座城最风光的时候，您都知道，北宋。"
  },
  {
   "role": "纵深",
   "text": "那时候它叫东京，为啥叫东京？"
  },
  {
   "role": "纵深",
   "text": "因为西边的京城是洛阳，它在东边，就叫东京。"
  },
  {
   "role": "纵深",
   "text": "清明上河图里画的，就是这座城。"
  },
  {
   "role": "纵深",
   "text": "一百万人口，商铺连汴河两岸，是当年全世界最繁华的城。"
  },
  {
   "role": "纵深",
   "text": "孟元老后来回忆它，写了本书，名字就叫东京梦华录。"
  },
  {
   "role": "纵深",
   "text": "梦华，梦里头的繁华。"
  },
  {
   "role": "反转",
   "text": "再说个您想不到的。"
  },
  {
   "role": "反转",
   "text": "这座城，把东南西北的京，快叫全了。"
  },
  {
   "role": "反转",
   "text": "北宋叫东京。"
  },
  {
   "role": "反转",
   "text": "金朝占了它，改叫南京。"
  },
  {
   "role": "反转",
   "text": "到了明朝洪武年间，朱元璋又把它定为北京。"
  },
  {
   "role": "反转",
   "text": "今早咱唠的北京，当时还叫北平呢。"
  },
  {
   "role": "反转",
   "text": "您看，东京，南京，北京，一座城都当过。"
  },
  {
   "role": "反转",
   "text": "一城三京，这在全中国是独一份。"
  },
  {
   "role": "今昔",
   "text": "可惜，这座城的命，跟黄河绑在一起。"
  },
  {
   "role": "今昔",
   "text": "黄河一发脾气，城就淹一回。"
  },
  {
   "role": "今昔",
   "text": "淹一回，埋一回，后人在上头再建一回。"
  },
  {
   "role": "今昔",
   "text": "今天的开封城底下，摞着六座古城。"
  },
  {
   "role": "今昔",
   "text": "地面上的开封，是站在一层层前辈肩膀上的开封。"
  },
  {
   "role": "收尾",
   "text": "劳您在评论区写下四个字，汴水长流。"
  },
  {
   "role": "收尾",
   "text": "写给这座淹不倒的城，也写给咱自己的日子。"
  },
  {
   "role": "收尾",
   "text": "您要是还有自己家乡的老地名，想弄明白来龙去脉，也请在评论区报个名。"
  },
  {
   "role": "收尾",
   "text": "下回，咱就唠您点的那座城。"
  },
  {
   "role": "收尾",
   "text": "末了多说一句，有些老底子里的讲究，晚知道一天，根就薄上那么一层。"
  },
  {
   "role": "收尾",
   "text": "一座城，给皇帝让过名，给黄河让过路，可它三千年来，就没让过一口气。"
  },
  {
   "role": "收尾",
   "text": "以史为鉴，可以知兴替。"
  },
  {
   "role": "收尾",
   "text": "劳您点个关注，咱们不走散。"
  },
  {
   "role": "收尾",
   "text": "下回接着给您唠，您点的那座城。"
  }
 ]
}