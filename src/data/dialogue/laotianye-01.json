  "lines": [
    { "role": "开场", "text": "老天爷，是讲规矩的。" },
    { "role": "开场", "text": "给了你吞吐天地的胃口，就不给你消化万年的肚子。" },
    { "role": "开场", "text": "可我今天，想换个问法。" },
    { "role": "开场", "text": "命里缺的那一块，到底是亏，还是成全？" },
    { "role": "层次", "text": "翻开历史，先看三个人。" },
    { "role": "层次", "text": "秦始皇，杜甫，岳飞。" },
    { "role": "层次", "text": "我们熟悉的他们，多半是接受的历史。" },
    { "role": "层次", "text": "可回到正史，你会发现。" },
    { "role": "层次", "text": "这三个人，都缺得明明白白。" },
    { "role": "始皇", "text": "秦始皇，缺的是寿。" },
    { "role": "始皇", "text": "他五十岁，死在沙丘。" },
    { "role": "始皇", "text": "可你反过来想。" },
    { "role": "始皇", "text": "他若再活三十年，大秦还是那个大秦吗。" },
    { "role": "始皇", "text": "暴政再拖三十年，六国的人心，只会更散。" },
    { "role": "始皇", "text": "老天爷让他早走，倒像是给大秦留了个体面。" },
    { "role": "始皇", "text": "有最硬的权，有最薄的命。" },
    { "role": "始皇", "text": "可这薄命，恰恰护住了他的名声。" },
    { "role": "杜甫", "text": "杜甫，缺的是饭碗。" },
    { "role": "杜甫", "text": "他住漏雨的茅屋，吃邻人接济的残羹。" },
    { "role": "杜甫", "text": "可你反过来想。" },
    { "role": "杜甫", "text": "他若一生顺遂，高官厚禄。" },
    { "role": "杜甫", "text": "还写得出安得广厦千万间吗。" },
    { "role": "杜甫", "text": "穷困，逼出了他的诗。" },
    { "role": "杜甫", "text": "那漏雨的茅屋，恰恰是他的诗魂。" },
    { "role": "岳飞", "text": "岳飞，缺的是明主。" },
    { "role": "岳飞", "text": "十二道金牌，一个风波亭，莫须有三字。" },
    { "role": "岳飞", "text": "可你反过来想。" },
    { "role": "岳飞", "text": "他若真直捣黄龙，功成身退，还会有今天的岳飞吗。" },
    { "role": "岳飞", "text": "恰恰是那场冤死，让精忠报国四个字，刻进了中国人的骨头。" },
    { "role": "岳飞", "text": "给他忠义的，不给他生路。" },
    { "role": "岳飞", "text": "可这绝路，反倒成全了他的千古。" },
    { "role": "翻案", "text": "你发现没有。" },
    { "role": "翻案", "text": "这三个人，都不是亏了。" },
    { "role": "翻案", "text": "秦始皇缺寿，护住了名声。" },
    { "role": "翻案", "text": "杜甫缺碗，逼出了诗魂。" },
    { "role": "翻案", "text": "岳飞缺明主，成全了千古。" },
    { "role": "翻案", "text": "这背后，不是老天爷偏心。" },
    { "role": "翻案", "text": "是缺和成，本来就是一笔账。" },
    { "role": "选择", "text": "往深了说。" },
    { "role": "选择", "text": "命里那一块，不是老天爷抠掉的，是你自己拿它换的。" },
    { "role": "选择", "text": "秦始皇拿寿，换了江山。" },
    { "role": "选择", "text": "杜甫拿饭碗，换了诗。" },
    { "role": "选择", "text": "岳飞拿生路，换了忠。" },
    { "role": "选择", "text": "你换走了什么，就缺了什么。" },
    { "role": "选择", "text": "你留下了什么，就成了什么。" },
    { "role": "人生", "text": "所以你现在回头看。" },
    { "role": "人生", "text": "觉得自己处处受阻，怀才不遇，命里缺一块。" },
    { "role": "人生", "text": "先别急着怪老天爷。" },
    { "role": "人生", "text": "先问问自己，你拿那块，换了什么。" },
    { "role": "人生", "text": "你缺的，可能正是你换出去的。" },
    { "role": "人生", "text": "你换回来的，可能正攥在你手里。" },
    { "role": "金句", "text": "中国人讲四个字，知足常乐。" },
    { "role": "金句", "text": "这不是让你认命。" },
    { "role": "金句", "text": "是让你看清，手里那一半，是你拿命里那块换来的。" },
    { "role": "金句", "text": "别只盯着缺的，忘了攥着的。" },
    { "role": "金句", "text": "端起的是活路，放下的是执念。" },
    { "role": "收尾", "text": "命里缺那一块，不是老天爷欠你的，是你自己给的价。" },
    { "role": "收尾", "text": "剩下这一块，才是你真正的本钱。" },
    { "role": "收尾", "text": "守住了，就是圆满。" }
  ]
}
