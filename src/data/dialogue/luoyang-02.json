{
  "label": "地名唠嗑-洛阳02",
  "topic": "洛阳为啥叫洛阳（长文案版）",
  "voices": {
    "旁白": "laoke-dashu-02"
  },
  "portraits": {
    "旁白": "out/luoyang01/洛阳故城-写实.png"
  },
  "colors": {
    "旁白": [
