  "lines": [
    {
      "role": "旁白",
      "text": "今天想跟您唠一个事。"
    },
    {
      "role": "旁白",
      "text": "洛阳，十三朝古都。"
    },
    {
      "role": "旁白",
      "text": "可这两个字，打哪儿来？"
    },
    {
      "role": "旁白",
      "text": "估摸着十个老伙计，"
    },
    {
      "role": "旁白",
      "text": "有八个得愣一下，说，"
    },
    {
      "role": "旁白",
      "text": "不就是洛河边上嘛。"
    },
    {
      "role": "旁白",
      "text": "这话呀，对了一半。"
    },
    {
      "role": "旁白",
      "text": "先说这洛。"
    },
    {
      "role": "旁白",
      "text": "洛阳城外这条河，叫洛水。"
    },
    {
      "role": "旁白",
      "text": "老祖宗起名字有个讲究，"
    },
    {
      "role": "旁白",
      "text": "山南水北，为阳。"
    },
    {
      "role": "旁白",
      "text": "城在洛水的北边，"
    },
    {
      "role": "旁白",
      "text": "所以叫洛阳。"
    },
    {
      "role": "旁白",
      "text": "翻两千年的老账本，"
    },
    {
      "role": "旁白",
      "text": "这个洛字，还有一段身世。"
    },
    {
      "role": "旁白",
      "text": "东汉定都，有一种说法："
    },
    {
      "role": "旁白",
      "text": "汉家自居火德，"
    },
    {
      "role": "旁白",
      "text": "火，最忌讳水。"
    },
    {
      "role": "旁白",
      "text": "去掉三点水，"
    },
    {
      "role": "旁白",
      "text": "改成了雒阳。"
    },
    {
      "role": "旁白",
      "text": "到了曹魏，又改了回来，"
    },
    {
      "role": "旁白",
      "text": "还是三点水的洛。"
    },
    {
      "role": "旁白",
      "text": "一个字来回折腾，"
    },
    {
      "role": "旁白",
      "text": "全是帝王心事。"
    },
    {
      "role": "旁白",
      "text": "先麻烦诸位老朋友抬抬手，"
    },
    {
      "role": "旁白",
      "text": "把那颗小红心按一下，"
    },
    {
      "role": "旁白",
      "text": "让更多爱听老故事的伙计，"
    },
    {
      "role": "旁白",
      "text": "也能刷到咱们。"
    },
    {
      "role": "旁白",
      "text": "您再想想这座城的分量。"
    },
    {
      "role": "旁白",
      "text": "白马寺，中国第一座官办寺院，"
    },
    {
      "role": "旁白",
      "text": "钟声从东汉响到今天。"
    },
    {
      "role": "旁白",
      "text": "龙门石窟，十万尊佛像，"
    },
    {
      "role": "旁白",
      "text": "一锤一锤，凿了四百年。"
    },
    {
      "role": "旁白",
      "text": "武则天的明堂，就在这城里。"
    },
    {
      "role": "旁白",
      "text": "一句洛阳纸贵，"
    },
    {
      "role": "旁白",
      "text": "说的是左思一篇赋，"
    },
    {
      "role": "旁白",
      "text": "让全城的纸都涨了价。"
    },
    {
      "role": "旁白",
      "text": "十三朝在这儿建都，"
    },
    {
      "role": "旁白",
      "text": "三千年文脉没断过，"
    },
    {
      "role": "旁白",
      "text": "硬是把中原这块土，"
    },
    {
      "role": "旁白",
      "text": "养成了天底下最厚重的一份家底。"
    },
    {
      "role": "旁白",
      "text": "劳您抬抬手，点个关注，"
    },
    {
      "role": "旁白",
      "text": "咱们不走散。"
    },
    {
      "role": "旁白",
      "text": "下回接着给您唠："
    },
    {
      "role": "旁白",
      "text": "长安，为啥改叫西安。"
    }
  ]
}