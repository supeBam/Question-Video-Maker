  "lines": [
    {
      "role": "开场",
      "text": "今天想跟您唠一个事。"
    },
    {
      "role": "开场",
      "text": "南京，六朝古都，咱们打小就熟。"
    },
    {
      "role": "开场",
      "text": "可要问南京为啥又叫金陵，"
    },
    {
      "role": "开场",
      "text": "金陵这俩字啥意思，"
    },
    {
      "role": "开场",
      "text": "十个老伙计，九个得支支吾吾。"
    },
    {
      "role": "开场",
      "text": "多数人张口就来："
    },
    {
      "role": "开场",
      "text": "金陵嘛，产金子，金山多。"
    },
    {
      "role": "开场",
      "text": "这话呀，不对。"
    },
    {
      "role": "开场",
      "text": "史书里头，白纸黑字记着："
    },
    {
      "role": "埋金",
      "text": "战国那会儿，楚威王灭了越国，"
    },
    {
      "role": "埋金",
      "text": "在石头山这地方筑了一座城。"
    },
    {
      "role": "埋金",
      "text": "筑城的时候，他干了一件怪事——"
    },
    {
      "role": "埋金",
      "text": "在城底下，埋了金子。"
    },
    {
      "role": "埋金",
      "text": "不是埋来花的，"
    },
    {
      "role": "埋金",
      "text": "是埋来「镇王气」的。"
    },
    {
      "role": "埋金",
      "text": "有一种说法：这地方有王者之气，"
    },
    {
      "role": "埋金",
      "text": "楚威王怕它日后冲出天子，"
    },
    {
      "role": "埋金",
      "text": "就拿金子给它压一压。"
    },
    {
      "role": "求赞",
      "text": "打这起，这座城就叫金陵邑。"
    },
    {
      "role": "求赞",
      "text": "您听明白了吧，"
    },
    {
      "role": "求赞",
      "text": "金陵的金子，不是用的，"
    },
    {
      "role": "求赞",
      "text": "是镇风水的。"
    },
    {
      "role": "求赞",
      "text": "讲到这，先麻烦诸位老朋友抬抬手，"
    },
    {
      "role": "泄王气",
      "text": "把屏幕底下那颗小红心按一下，"
    },
    {
      "role": "泄王气",
      "text": "就当给咱们这座老城留个心意，"
    },
    {
      "role": "泄王气",
      "text": "也让更多爱听老故事的朋友，"
    },
    {
      "role": "泄王气",
      "text": "把这金子底下的讲究瞧个明白。"
    },
    {
      "role": "泄王气",
      "text": "闲话搁一边，接着往下说。"
    },
    {
      "role": "泄王气",
      "text": "可故事还没完。"
    },
    {
      "role": "泄王气",
      "text": "一百多年后，秦始皇东巡，"
    },
    {
      "role": "泄王气",
      "text": "听人说金陵有王气，"
    },
    {
      "role": "泄王气",
      "text": "他心里不痛快——"
    },
    {
      "role": "泄王气",
      "text": "我刚统一天下，"
    },
    {
      "role": "泄王气",
      "text": "你这座城还敢憋着王气？"
    },
    {
      "role": "泄王气",
      "text": "有一种说法：他干脆叫人凿开山体，"
    },
    {
      "role": "变迁",
      "text": "挖出一条河，把王气泄掉，"
    },
    {
      "role": "变迁",
      "text": "还把金陵改了个名，"
    },
    {
      "role": "变迁",
      "text": "叫秣陵。"
    },
    {
      "role": "变迁",
      "text": "秣是啥？喂牲口的草料。"
    },
    {
      "role": "变迁",
      "text": "好端端一座金陵城，"
    },
    {
      "role": "变迁",
      "text": "让他贬成了一片草场。"
    },
    {
      "role": "变迁",
      "text": "一个埋金镇王气，"
    },
    {
      "role": "变迁",
      "text": "一个凿山泄王气，"
    },
    {
      "role": "变迁",
      "text": "两位皇帝，跟这座城的王气，"
    },
    {
      "role": "变迁",
      "text": "前后较了一百多年的劲。"
    },
    {
      "role": "变迁",
      "text": "您再想想这座城的分量。"
    },
    {
      "role": "变迁",
      "text": "钟山龙蟠，石头虎踞，"
    },
    {
      "role": "变迁",
      "text": "长江天堑，三面环水，"
    },
    {
      "role": "变迁",
      "text": "自古就是帝王建都的风水宝地。"
    },
    {
      "role": "变迁",
      "text": "东吴在这儿立了国，"
    },
    {
      "role": "今昔",
      "text": "东晋在这儿偏安半壁江山，"
    },
    {
      "role": "今昔",
      "text": "宋齐梁陈，一代接一代，"
    },
    {
      "role": "今昔",
      "text": "六朝古都，十朝都会。"
    },
    {
      "role": "今昔",
      "text": "到了明朝洪武元年，"
    },
    {
      "role": "今昔",
      "text": "朱元璋在这儿登基，"
    },
    {
      "role": "今昔",
      "text": "把应天府定名南京。"
    },
    {
      "role": "今昔",
      "text": "南京这个名字，"
    },
    {
      "role": "今昔",
      "text": "一叫又是六百多年。"
    },
    {
      "role": "今昔",
      "text": "您再往深里琢磨："
    },
    {
      "role": "今昔",
      "text": "从金陵邑算起，两千三百多年，"
    },
    {
      "role": "今昔",
      "text": "名字改了七八次，"
    },
    {
      "role": "今昔",
      "text": "金陵、秣陵、建业、建康、"
    },
    {
      "role": "今昔",
      "text": "江宁、应天、南京，"
    },
    {
      "role": "今昔",
      "text": "一座城，把大半部中国史"
    },
    {
      "role": "收尾",
      "text": "都装进名字里了。"
    },
    {
      "role": "收尾",
      "text": "可如今游客到了南京，"
    },
    {
      "role": "收尾",
      "text": "张嘴就是盐水鸭、夫子庙、"
    },
    {
      "role": "收尾",
      "text": "梧桐大道、南京眼，"
    },
    {
      "role": "收尾",
      "text": "你要问他金陵的金子埋在哪儿，"
    },
    {
      "role": "收尾",
      "text": "南京这个名字打哪来，"
    },
    {
      "role": "收尾",
      "text": "十个里头九个答不上来。"
    },
    {
      "role": "收尾",
      "text": "这座城守了两千多年，"
    },
    {
      "role": "收尾",
      "text": "守的是六朝烟水的风流，"
    },
    {
      "role": "收尾",
      "text": "守的是龙蟠虎踞的气象。"
    },
    {
      "role": "收尾",
      "text": "这份家底，"
    },
    {
      "role": "收尾",
      "text": "不能在咱们手里断了线。"
    },
    {
      "role": "收尾",
      "text": "劳您在评论区写下四个字："
    },
    {
      "role": "收尾",
      "text": "金陵永安。"
    },
    {
      "role": "收尾",
      "text": "写给这座埋过金子的老城，"
    },
    {
      "role": "收尾",
      "text": "也写给自己。"
    },
    {
      "role": "收尾",
      "text": "您要是还有自己家乡的老地名，"
    },
    {
      "role": "收尾",
      "text": "想弄明白来龙去脉，"
    },
    {
      "role": "收尾",
      "text": "也请在评论区报个名，"
    },
    {
      "role": "收尾",
      "text": "下回，咱就唠您点的那座城。"
    },
    {
      "role": "收尾",
      "text": "末了多说一句，"
    },
    {
      "role": "收尾",
      "text": "有些老底子里的讲究，"
    },
    {
      "role": "收尾",
      "text": "晚知道一天，"
    },
    {
      "role": "收尾",
      "text": "根就薄上那么一层。"
    },
    {
      "role": "收尾",
      "text": "一座城，钟山脚下，"
    },
    {
      "role": "收尾",
      "text": "两千三百年文脉不断，"
    },
    {
      "role": "收尾",
      "text": "硬是把这块石头，"
    },
    {
      "role": "收尾",
      "text": "养成了王气不散的一份家底。"
    },
    {
      "role": "收尾",
      "text": "劳您点个关注，咱们不走散。"
    },
    {
      "role": "收尾",
      "text": "下回接着给您唠，"
    },
    {
      "role": "收尾",
      "text": "您点的那座城。"
    }
  ]
}