  "lines": [
    { "role": "开场", "text": "《史记》里，秦朝的结局，写得触目惊心。" },
    { "role": "开场", "text": "公子、公主，几十口宗室，一个活口没留。" },
    { "role": "开场", "text": "咸阳城里，尸首堆成小山，血流成河。" },
    { "role": "开场", "text": "问题来了：是谁，把大秦整得这么惨？" },
    { "role": "开场", "text": "很多人说，是项羽，是刘邦。" },
    { "role": "开场", "text": "我的看法是：都不是。" },
    { "role": "层次", "text": "先说明白一件事。" },
    { "role": "层次", "text": "我们今天知道的秦朝灭亡，多半是「接受的历史」。" },
    { "role": "层次", "text": "暴秦、项羽屠城、火烧咸阳宫。" },
    { "role": "层次", "text": "可回到「记录的历史」——《史记》——" },
    { "role": "层次", "text": "你会发现，真正要了大秦命的，是它自己人。" },
    { "role": "层次", "text": "从内部，先把家底掏空了。" },
    { "role": "沙丘", "text": "秦始皇，死在沙丘。" },
    { "role": "沙丘", "text": "临死写下遗诏，命长子扶苏，回咸阳继位。" },
    { "role": "沙丘", "text": "这封诏书，落在了赵高手里。" },
    { "role": "沙丘", "text": "赵高是谁？管皇帝车马的，中车府令。" },
    { "role": "沙丘", "text": "他扣下诏书，去找丞相李斯。" },
    { "role": "沙丘", "text": "一句话，戳中李斯的痛处：" },
    { "role": "沙丘", "text": "扶苏登基，必重用蒙恬。" },
    { "role": "沙丘", "text": "到那时，你李斯的相位，还保得住吗？" },
    { "role": "沙丘", "text": "李斯怕了。" },
    { "role": "沙丘", "text": "就这一念私心，大秦的国运，拐进了死胡同。" },
    { "role": "扶苏", "text": "假诏送到北方。" },
    { "role": "扶苏", "text": "扶苏正和蒙恬，带着三十万大军，镇守边关。" },
    { "role": "扶苏", "text": "蒙恬劝他：区区一个使者，您就信了？" },
    { "role": "扶苏", "text": "万一是诈呢？" },
    { "role": "扶苏", "text": "扶苏说：父命子死，子不得不死。" },
    { "role": "扶苏", "text": "拔剑，自刎。" },
    { "role": "扶苏", "text": "蒙恬不肯就范，也被关进大牢，吞药自尽。" },
    { "role": "扶苏", "text": "你看——" },
    { "role": "扶苏", "text": "大秦最能打的将军，没死在战场，死在阴谋里。" },
    { "role": "扶苏", "text": "最该继位的公子，没死在敌人刀下，死在一封假诏书里。" },
    { "role": "指鹿", "text": "胡亥继位，就是秦二世。" },
    { "role": "指鹿", "text": "赵高不教他治国，教他享乐、杀人立威。" },
    { "role": "指鹿", "text": "兄弟姐妹，一个个被安上罪名，处死。" },
    { "role": "指鹿", "text": "宗室子弟，血流了一地。" },
    { "role": "指鹿", "text": "赵高还不满足。" },
    { "role": "指鹿", "text": "他牵来一头鹿，硬说，这是千里马。" },
    { "role": "指鹿", "text": "朝堂上，谁敢说这是鹿，转头就治罪。" },
    { "role": "指鹿", "text": "顺着说马的，升官发财。" },
    { "role": "指鹿", "text": "到这一步，大秦的朝堂，还有一句真话吗？" },
    { "role": "指鹿", "text": "没有了。" },
    { "role": "指鹿", "text": "整个朝廷，成了赵高一个人的一言堂。" },
    { "role": "李斯", "text": "李斯呢？" },
    { "role": "李斯", "text": "赵高反手给他安了谋反的罪名，腰斩，满门抄斩。" },
    { "role": "李斯", "text": "临刑前，李斯回头看着小儿子，老泪纵横：" },
    { "role": "李斯", "text": "儿啊，我还想跟你，牵着家里那条黄狗，" },
    { "role": "李斯", "text": "出上蔡东门，去追兔子。" },
    { "role": "李斯", "text": "那样的日子，再也回不去了。" },
    { "role": "李斯", "text": "李斯冤不冤？冤。" },
    { "role": "李斯", "text": "可当年沙丘，他为保相位，跟赵高合谋的那一刻，" },
    { "role": "李斯", "text": "就该想到：与虎谋皮，早晚被虎吃掉。" },
    { "role": "章邯", "text": "这时候，天下已经乱了。" },
    { "role": "章邯", "text": "陈胜吴广，大泽乡振臂一呼：" },
    { "role": "章邯", "text": "王侯将相，宁有种乎？" },
    { "role": "章邯", "text": "秦朝有没有兵？有。" },
    { "role": "章邯", "text": "北边三十万，南边几十万。" },
    { "role": "章邯", "text": "可咸阳城里，忙着争权，没人敢调兵回援。" },
    { "role": "章邯", "text": "章邯没办法，赦免了骊山修陵的几十万囚徒，临时凑成一支军。" },
    { "role": "章邯", "text": "横扫六国的大秦，到最后，保卫都城的，是一群修墓的囚犯。" },
    { "role": "章邯", "text": "章邯在前线浴血奋战，赵高在后方处处猜忌。" },
    { "role": "章邯", "text": "打输了问罪，打赢了也问罪。" },
    { "role": "章邯", "text": "走投无路，章邯长叹一声，带着二十万秦军，投降了项羽。" },
    { "role": "章邯", "text": "大秦最后一支主力，不是败给敌人，是败给自己。" },
    { "role": "巨鹿", "text": "巨鹿之战，项羽破釜沉舟，几万人，打垮了秦军。" },
    { "role": "巨鹿", "text": "秦朝最后一点家底，输得干干净净。" },
    { "role": "巨鹿", "text": "赵高看胡亥碍事，派人闯进皇宫，逼他自杀。" },
    { "role": "巨鹿", "text": "胡亥才二十四岁，躲在帷帐后，浑身发抖。" },
    { "role": "巨鹿", "text": "他求：不当皇帝了，封我个郡王，行不行？不行。" },
    { "role": "巨鹿", "text": "做个万户侯，行不行？不行。" },
    { "role": "巨鹿", "text": "带着妻儿做老百姓，总可以吧？" },
    { "role": "巨鹿", "text": "来人说：我奉丞相之命，为天下人，诛杀你。" },
    { "role": "巨鹿", "text": "胡亥到死都没想明白：他最信任的赵高，怎么要他的命。" },
    { "role": "巨鹿", "text": "赵高杀了胡亥，立子婴。" },
    { "role": "巨鹿", "text": "子婴不是傀儡。" },
    { "role": "巨鹿", "text": "他装病，引赵高来探病，一刀杀了他，灭三族。" },
    { "role": "巨鹿", "text": "子婴有没有本事？有。" },
    { "role": "巨鹿", "text": "可大秦这辆战车，早就散了架。" },
    { "role": "巨鹿", "text": "他满打满算，只当了四十六天秦王。" },
    { "role": "巨鹿", "text": "刘邦打进咸阳，子婴投降，刘邦没杀他。" },
    { "role": "巨鹿", "text": "项羽来了，杀子婴、屠咸阳、火烧秦宫。" },
    { "role": "巨鹿", "text": "那把火，烧了三个月。" },
    { "role": "翻案", "text": "大秦，从统一天下到灭亡，短短十五年。" },
    { "role": "翻案", "text": "很多人说，亡于项羽，亡于刘邦。" },
    { "role": "翻案", "text": "我偏说：项羽刘邦，不过是最后来收债的人。" },
    { "role": "翻案", "text": "真正把大秦败光的，是赵高的野心，是李斯的私心，" },
    { "role": "翻案", "text": "是胡亥的昏庸，是那帮从内部拆台的自己人。" },
    { "role": "翻案", "text": "外敌来了，不可怕。" },
    { "role": "翻案", "text": "可怕的是，家里面先烂了根。" },
    { "role": "金句", "text": "历史啊，比戏文还狠。" },
    { "role": "金句", "text": "戏演完，演员还能卸妆下台。" },
    { "role": "金句", "text": "历史走错一步，就是万万人头落地。" },
    { "role": "金句", "text": "一个家、一个国，最怕的不是外面有人骂，是里面有人拆。" },
    { "role": "金句", "text": "所以你看，秦朝不是天要亡它，是人要亡它。" },
    { "role": "金句", "text": "不是敌人太强，是自己太作。" },
    { "role": "金句", "text": "认同的朋友，评论区打四个字：自作自受。" },
    { "role": "金句", "text": "历史从不偏心，谁作死，谁买单。" },
    { "role": "带货", "text": "今天这段秦朝，先讲到这儿。" },
    { "role": "带货", "text": "有老朋友问我，这些历史门道，越听越上瘾，可没空一本本啃史书，有没有省事的法子，系统地补一补？" },
    { "role": "带货", "text": "我给您指条路，就是这本书，一看就上瘾的中国文化一千问。" },
    { "role": "带货", "text": "它把中国文化里最该知道的一千个问题，用一问一答，全给您理得明明白白。" },
    { "role": "带货", "text": "上到朝代更替、帝王将相，下到民俗节日、诗词歌赋，翻到哪一页，都是能跟人聊半天的谈资。" },
    { "role": "带货", "text": "今天讲的赵高指鹿为马、李斯东门黄犬，这些门道，书里都掰开揉碎了，讲得透透的。" },
    { "role": "带货", "text": "自己看，长见识。给孩子，长学问。送老人，解闷养心。" },
    { "role": "带货", "text": "想要的朋友，点视频下方的小黄车，或者进我橱窗挑一挑。" },
    { "role": "带货", "text": "咱一边看视频涨知识，一边读书养根。" },
    { "role": "收尾", "text": "下期，讲刘邦进咸阳，约法三章。" },
    { "role": "收尾", "text": "点个关注，咱们下期接着唠。" }
  ]
}
