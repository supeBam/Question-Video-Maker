  "lines": [
    {
      "role": "开场",
      "text": "两千多年过去。"
    },
    {
      "role": "开场",
      "text": "你还能脱口而出的，是哪句话？"
    },
    {
      "role": "开场",
      "text": "是犯强汉者，虽远必诛。"
    },
    {
      "role": "开场",
      "text": "还是王侯将相，宁有种乎。",
      "tts": "还是王侯将相，宁有种。"
    },
    {
      "role": "开场",
      "text": "这些字，你早就会写。"
    },
    {
      "role": "开场",
      "text": "可你有没有想过一个问题。"
    },
    {
      "role": "开场",
      "text": "它们凭什么，能活这么久。"
    },
    {
      "role": "开场",
      "text": "一句话，没有腿，也没有命。"
    },
    {
      "role": "开场",
      "text": "可它能跨过两千年，走到今天。"
    },
    {
      "role": "开场",
      "text": "这中间，藏着个道理，叫精气神。"
    },
    {
      "role": "开场",
      "text": "今天，我把老祖宗传下来的十句话，一句一句，讲给您听。"
    },
    {
      "role": "陈汤",
      "text": "先讲一个人，陈汤。"
    },
    {
      "role": "陈汤",
      "text": "他写下十个字，犯强汉者，虽远必诛。"
    },
    {
      "role": "陈汤",
      "text": "当年匈奴的单于，逃到了中亚。"
    },
    {
      "role": "陈汤",
      "text": "朝廷嫌远，不想追。"
    },
    {
      "role": "陈汤",
      "text": "陈汤不等命令，带着西域的人马，一路追了过去。"
    },
    {
      "role": "陈汤",
      "text": "有人问他，凭什么。"
    },
    {
      "role": "陈汤",
      "text": "他说，欺君，我认。"
    },
    {
      "role": "陈汤",
      "text": "放人，我不认。"
    },
    {
      "role": "陈汤",
      "text": "这叫什么。"
    },
    {
      "role": "陈汤",
      "text": "叫一个普通人，把责任，扛在了自己肩上。"
    },
    {
      "role": "陈汤",
      "text": "两千年下来，这十个字，还是压不住的一口正气。"
    },
    {
      "role": "陈胜",
      "text": "再讲一个种地的，陈胜。"
    },
    {
      "role": "陈胜",
      "text": "他喊出一句，王侯将相，宁有种乎。",
      "tts": "他喊出一句，王侯将相，宁有种。"
    },
    {
      "role": "陈胜",
      "text": "这话，不是豪言。"
    },
    {
      "role": "陈胜",
      "text": "是几百个被逼到绝路的人，咬着牙吐出来的。"
    },
    {
      "role": "陈胜",
      "text": "一场大雨，误了期限。"
    },
    {
      "role": "陈胜",
      "text": "按秦律，当斩。"
    },
    {
      "role": "陈胜",
      "text": "左右都是死。"
    },
    {
      "role": "陈胜",
      "text": "他才问，王侯将相，难道天生就命好。"
    },
    {
      "role": "陈胜",
      "text": "一个种地的，敢说这句话。"
    },
    {
      "role": "陈胜",
      "text": "他就替天下穷人，问了一声，凭什么。"
    },
    {
      "role": "陈胜",
      "text": "这一问，问了两千多年。"
    },
    {
      "role": "文天祥",
      "text": "南宋末年，一个读书人，叫文天祥。"
    },
    {
      "role": "文天祥",
      "text": "他写下，人生自古谁无死。"
    },
    {
      "role": "文天祥",
      "text": "留取丹心照汗青。"
    },
    {
      "role": "文天祥",
      "text": "那时候，国已经没了。"
    },
    {
      "role": "文天祥",
      "text": "敌人拿糖来换他的命，他不肯。"
    },
    {
      "role": "文天祥",
      "text": "拿刀来吓他，他也不肯。"
    },
    {
      "role": "文天祥",
      "text": "最后，他朝南边一拜，从容上路。"
    },
    {
      "role": "文天祥",
      "text": "人死了，可那两句话，替他把脊梁，留到了今天。"
    },
    {
      "role": "文天祥",
      "text": "我常想，读书人到底读什么。"
    },
    {
      "role": "文天祥",
      "text": "读到最后，读的就是这一口气。"
    },
    {
      "role": "顾炎武",
      "text": "明末，又出来一个人，顾炎武。"
    },
    {
      "role": "顾炎武",
      "text": "人人都说，他讲过八个字。"
    },
    {
      "role": "顾炎武",
      "text": "天下兴亡，匹夫有责。"
    },
    {
      "role": "顾炎武",
      "text": "其实，他写的并不是这八个字。"
    },
    {
      "role": "顾炎武",
      "text": "是后人，把他那篇文字，提炼成了这八个字。"
    },
    {
      "role": "顾炎武",
      "text": "这里头，藏着一件事。"
    },
    {
      "role": "顾炎武",
      "text": "有些话，它一诞生，就不属于一个人了。"
    },
    {
      "role": "顾炎武",
      "text": "它属于所有，听着就挺直腰杆的人。"
    },
    {
      "role": "顾炎武",
      "text": "这，就是话的命。"
    },
    {
      "role": "顾炎武",
      "text": "人走了，话活下来，还越活越响。"
    },
    {
      "role": "林则徐",
      "text": "清朝，一个大臣，叫林则徐。"
    },
    {
      "role": "林则徐",
      "text": "虎门一把火，烧了洋人的鸦片。"
    },
    {
      "role": "林则徐",
      "text": "朝廷怕了，把他发配到新疆。"
    },
    {
      "role": "林则徐",
      "text": "半路上，他写下两句。"
    },
    {
      "role": "林则徐",
      "text": "苟利国家生死以。"
    },
    {
      "role": "林则徐",
      "text": "岂因祸福避趋之。"
    },
    {
      "role": "林则徐",
      "text": "翻成大白话，就是。"
    },
    {
      "role": "林则徐",
      "text": "只要对国家有利，这条命豁出去，也行。"
    },
    {
      "role": "林则徐",
      "text": "他被自己的国，赶出了家门。"
    },
    {
      "role": "林则徐",
      "text": "可心里，还装着他的国。"
    },
    {
      "role": "林则徐",
      "text": "您说，这样的人，是不是傻。"
    },
    {
      "role": "林则徐",
      "text": "要我说，这不是傻，是干净。"
    },
    {
      "role": "数风流",
      "text": "再往后，一个站在黄河边的人，写下。"
    },
    {
      "role": "数风流",
      "text": "数风流人物，还看今朝。"
    },
    {
      "role": "数风流",
      "text": "写这话的时候，他刚走完最苦的一段路。"
    },
    {
      "role": "数风流",
      "text": "身边的人，折了大半。"
    },
    {
      "role": "数风流",
      "text": "前头，还是一片未知。"
    },
    {
      "role": "数风流",
      "text": "可他一抬头，说的是，还看今朝。"
    },
    {
      "role": "数风流",
      "text": "这不是狂。"
    },
    {
      "role": "数风流",
      "text": "是人在最黑的时候，还信得见天亮。"
    },
    {
      "role": "数风流",
      "text": "这份心气，比江山，还值钱。"
    },
    {
      "role": "周恩来",
      "text": "还有一个十二岁的孩子。"
    },
    {
      "role": "周恩来",
      "text": "老师问他，为什么读书。"
    },
    {
      "role": "周恩来",
      "text": "别人说，做官，挣钱。"
    },
    {
      "role": "周恩来",
      "text": "他站起来，说了一句。"
    },
    {
      "role": "周恩来",
      "text": "为中华之崛起而读书。"
    },
    {
      "role": "周恩来",
      "text": "那年，中国正被按在地上。"
    },
    {
      "role": "周恩来",
      "text": "一个孩子，心里装的是整个国。"
    },
    {
      "role": "周恩来",
      "text": "后来，他用一辈子，把这句话，走成了路。"
    },
    {
      "role": "周恩来",
      "text": "一句话，进了孩子的耳朵。"
    },
    {
      "role": "周恩来",
      "text": "就能长成他以后的样子。"
    },
    {
      "role": "周恩来",
      "text": "您说，这话，重不重。"
    },
    {
      "role": "站起来",
      "text": "还有一句，咱们都听过。"
    },
    {
      "role": "站起来",
      "text": "中国人民，从此站起来了。"
    },
    {
      "role": "站起来",
      "text": "我头一回听，只觉得，是句喜庆话。"
    },
    {
      "role": "站起来",
      "text": "后来才懂。"
    },
    {
      "role": "站起来",
      "text": "这句话前面，是一百多年的屈辱。"
    },
    {
      "role": "站起来",
      "text": "是一代又一代人，弯着腰，熬过来的。"
    },
    {
      "role": "站起来",
      "text": "到这一刻，才把腰，直起来。"
    },
    {
      "role": "站起来",
      "text": "所以它不是一句口号。"
    },
    {
      "role": "站起来",
      "text": "是一整个民族，憋了上百年的那口气。"
    },
    {
      "role": "站起来",
      "text": "吐出来，顶一万句。"
    },
    {
      "role": "不到长城",
      "text": "还有一句，不到长城，非好汉。"
    },
    {
      "role": "不到长城",
      "text": "小时候，我只当这是句狠话。"
    },
    {
      "role": "不到长城",
      "text": "长大才明白。"
    },
    {
      "role": "不到长城",
      "text": "说这话的人，那会儿正带着队伍翻雪山。"
    },
    {
      "role": "不到长城",
      "text": "人越来越少，路越走越难。"
    },
    {
      "role": "不到长城",
      "text": "他说这一句，不是吼给长城听的。"
    },
    {
      "role": "不到长城",
      "text": "是吼给身边每一个，快撑不住的人听的。"
    },
    {
      "role": "不到长城",
      "text": "挺住。"
    },
    {
      "role": "不到长城",
      "text": "没到终点，就别倒。"
    },
    {
      "role": "不到长城",
      "text": "这六个字，救过多少人的命。"
    },
    {
      "role": "这一仗",
      "text": "最后一句，最不讲究文采。"
    },
    {
      "role": "这一仗",
      "text": "这一仗，我们不打，就留给下一代打。"
    },
    {
      "role": "这一仗",
      "text": "那年冬，冷到骨子里。"
    },
    {
      "role": "这一仗",
      "text": "对面有飞机，有坦克。"
    },
    {
      "role": "这一仗",
      "text": "我们的战士，连棉衣，都凑不齐。"
    },
    {
      "role": "这一仗",
      "text": "可还是，打了。"
    },
    {
      "role": "这一仗",
      "text": "打的地方，冻到零下几十度。"
    },
    {
      "role": "这一仗",
      "text": "有人端着枪，就那样冻在了雪里。"
    },
    {
      "role": "这一仗",
      "text": "这一句，为什么让人掉泪。"
    },
    {
      "role": "这一仗",
      "text": "因为它说的，不是输赢。"
    },
    {
      "role": "这一仗",
      "text": "是一个父亲的逻辑。"
    },
    {
      "role": "这一仗",
      "text": "我吃的苦，不让孩子吃。"
    },
    {
      "role": "这一仗",
      "text": "这是十句话里，最老，最重的一句。"
    },
    {
      "role": "过渡",
      "text": "您看，这十句话，一句，站着一个中国人。"
    },
    {
      "role": "过渡",
      "text": "人活了，历史就活了。"
    },
    {
      "role": "过渡",
      "text": "可这十句话，只是根。"
    },
    {
      "role": "过渡",
      "text": "根往上，还长着一整棵树。"
    },
    {
      "role": "过渡",
      "text": "中国这两个字，最早刻在一件青铜器上。"
    },
    {
      "role": "过渡",
      "text": "写的，是宅兹中国。"
    },
    {
      "role": "过渡",
      "text": "这两个字，咱们叫了三千多年。"
    },
    {
      "role": "过渡",
      "text": "蹴鞠，就是今天的足球，战国就有了。"
    },
    {
      "role": "过渡",
      "text": "伞，老话讲，是鲁班造的。"
    },
    {
      "role": "过渡",
      "text": "风筝，是墨子放的。"
    },
    {
      "role": "过渡",
      "text": "豆浆，是刘安点出来的。"
    },
    {
      "role": "过渡",
      "text": "二十四节气，是中国人独有的时间机关。"
    },
    {
      "role": "过渡",
      "text": "一根针，一根线，也有自己的讲究。"
    },
    {
      "role": "过渡",
      "text": "这些，都是同一棵树上的枝子。"
    },
    {
      "role": "过渡",
      "text": "树大，才能挡风。"
    },
    {
      "role": "过渡",
      "text": "根深，才能站得稳。"
    },
    {
      "role": "常识",
      "text": "这棵树，枝子多得数不过来。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    },
    {
      "role": "常识",
      "text": "我随口考您几个。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "中国的国树，是什么。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "是银杏。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "国花，是什么。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "是牡丹。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "国歌的词，是谁写的。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "是田汉。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "曲，是谁作的。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "是聂耳。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "五星红旗，是谁设计的。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "一个叫曾联松的人。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "弱冠，是二十岁。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "而立，是三十。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "不惑，是四十。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "一日不见，如隔三秋。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "这个三秋，是九个月。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "五花八门，五花，说的是五种行当。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "这些事，听着小。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "凑到一块，就是一整个中国。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "常识",
      "text": "课本里，常常不写。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    },
    {
      "role": "常识",
      "text": "可考试里，年年都考。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    },
    {
      "role": "带货",
      "text": "我把话说到实处。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "一个孩子有没有见识，不看报多少班。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "看的是，根扎得深不深。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "一千个常识，一问一答，就是一千根须。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "每天十分钟，一点点，往下扎。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "小学打底，初中稳分，高中，拉开差距。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "差的那几分，攒到一起，就隔开两条路。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "我给您指条路。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "就是这本书，一看就上瘾的中国文化一千问。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    },
    {
      "role": "带货",
      "text": "王朝怎么更替，节气怎么流转。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "带货",
      "text": "诗词怎么读，民俗怎么过。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "带货",
      "text": "它都掰开揉碎，讲得透透的。",
      "img": "assets/book_1000wen/03_内页翻开.png"
    },
    {
      "role": "带货",
      "text": "自己看，长见识。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "给孩子，立根基。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "送老人，解闷养心。",
      "img": "assets/book_1000wen/02_斜放另角度.png"
    },
    {
      "role": "带货",
      "text": "想要的朋友，点下方小黄车，进我橱窗挑一挑。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    },
    {
      "role": "带货",
      "text": "咱们一边涨知识，一边把根，扎下去。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    },
    {
      "role": "带货",
      "text": "历史从未走远。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    },
    {
      "role": "带货",
      "text": "它就藏在这一千个问里，等你来认。",
      "img": "assets/book_1000wen/01_站立主视觉.png"
    }
  ]
}