  "lines": [
    {
      "role": "开场",
      "text": "这六个寓言成语，小时候当故事听，越长大，越懂。"
    },
    {
      "role": "揠苗助长",
      "text": "宋国有个人嫌禾苗长得慢，一棵棵往上拔，结果苗全枯死了。急于求成，反而坏事。出自《孟子》。"
    },
    {
      "role": "掩耳盗铃",
      "text": "有人偷铃铛，捂住自己的耳朵，以为别人也听不见。自欺欺人。出自《吕氏春秋》。"
    },
    {
      "role": "自相矛盾",
      "text": "卖矛的人夸口：我的矛无坚不摧，我的盾无物能挡。有人问，拿你的矛戳你的盾呢？出自《韩非子》。"
    },
    {
      "role": "郑人买履",
      "text": "郑国有个人买鞋，只信量好的尺码，不信自己的脚，宁可回家取尺码也不肯试穿。死搬教条。出自《韩非子》。"
    },
    {
      "role": "塞翁失马",
      "text": "边塞老人丢了马，别人替他不值，他说这未必是坏事。果然，那匹马带回了一群骏马。祸福相依。出自《淮南子》。"
    },
    {
      "role": "愚公移山",
      "text": "九十岁的愚公要搬走门前两座大山，别人笑他傻，他说子子孙孙无穷尽。坚持下去，山也能移。出自《列子》。"
    },
    {
      "role": "结尾",
      "text": "收藏起来，讲给孩子听。下期讲动物成语，关注不迷路。"
    }
  ]
}