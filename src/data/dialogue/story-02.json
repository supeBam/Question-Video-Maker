  "lines": [
    {
      "role": "开场",
      "text": "这六个动物成语，小时候都会背，长大后才发现，说的都是人。"
    },
    {
      "role": "画蛇添足",
      "text": "几个人比赛画蛇，画得最快的那个人，顺手给蛇添上四只脚，赢的酒被别人端走了。多此一举。出自《战国策》。"
    },
    {
      "role": "狐假虎威",
      "text": "狐狸被老虎捉住，谎称自己是百兽之王，让老虎跟在身后走，百兽见了纷纷逃跑。借别人的威势吓唬人。出自《战国策》。"
    },
    {
      "role": "惊弓之鸟",
      "text": "神箭手更羸只拉弓、不放箭，一只大雁应声而落。原来它受过箭伤，一听弓弦响就吓坏了。心有余悸。出自《战国策》。"
    },
    {
      "role": "鹤立鸡群",
      "text": "一只鹤站在鸡群里，一眼就能看见。说的是嵇绍气度不凡，在人群中卓然出众。比喻才华或仪表出众。出自《世说新语》。"
    },
    {
      "role": "狼狈为奸",
      "text": "传说狼的前腿长，狈的前腿短，狈要趴在狼身上才能走路。两个坏人互相勾结做坏事。出自《酉阳杂俎》。"
    },
    {
      "role": "打草惊蛇",
      "text": "县令王鲁贪赃枉法，百姓写状子告他的手下：你虽然打的是草，蛇已经吓坏了。做事不密，惊动对方。出自《南唐近事》。"
    },
    {
      "role": "结尾",
      "text": "收藏起来，讲给孩子听。下期讲十二生肖里的成语，关注不迷路。"
    }
  ]
}