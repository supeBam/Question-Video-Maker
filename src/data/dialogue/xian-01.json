  "lines": [
    {
      "role": "开场",
      "text": "今天想跟您唠一个事。"
    },
    {
      "role": "开场",
      "text": "西安，十三朝古都，咱们打小就知道。"
    },
    {
      "role": "开场",
      "text": "可要问西安这俩字啥意思，"
    },
    {
      "role": "开场",
      "text": "为啥叫西安，不叫别的，"
    },
    {
      "role": "开场",
      "text": "十个老伙计，九个得支支吾吾。"
    },
    {
      "role": "开场",
      "text": "多数人张口就来：这还不简单，"
    },
    {
      "role": "开场",
      "text": "长安改成西安，"
    },
    {
      "role": "开场",
      "text": "西边安定了，就叫西安呗。"
    },
    {
      "role": "诏书",
      "text": "这话，只说对了一半。"
    },
    {
      "role": "诏书",
      "text": "史书里头，白纸黑字写着："
    },
    {
      "role": "诏书",
      "text": "洪武二年三月，"
    },
    {
      "role": "诏书",
      "text": "大将军徐达进兵奉元路，"
    },
    {
      "role": "诏书",
      "text": "改路，为西安府。"
    },
    {
      "role": "诏书",
      "text": "您细品，改的是奉元路，"
    },
    {
      "role": "诏书",
      "text": "不是长安。"
    },
    {
      "role": "诏书",
      "text": "长安，从汉高祖那会儿起，"
    },
    {
      "role": "诏书",
      "text": "就是个县名，"
    },
    {
      "role": "诏书",
      "text": "取的是长治久安，"
    },
    {
      "role": "诏书",
      "text": "两千多年，基本没动过。"
    },
    {
      "role": "诏书",
      "text": "明朝改的，是府名。"
    },
    {
      "role": "边关",
      "text": "那为啥偏偏叫西安？"
    },
    {
      "role": "边关",
      "text": "您得站在洪武二年往北看："
    },
    {
      "role": "边关",
      "text": "北元还在草原上盯着，"
    },
    {
      "role": "边关",
      "text": "西北，就是大明的前线。"
    },
    {
      "role": "边关",
      "text": "这个安字，是安谁的？"
    },
    {
      "role": "边关",
      "text": "安西北。"
    },
    {
      "role": "边关",
      "text": "西安，就是朱元璋镇守西北，"
    },
    {
      "role": "边关",
      "text": "落下的一颗定盘星。"
    },
    {
      "role": "边关",
      "text": "所以说白了，"
    },
    {
      "role": "边关",
      "text": "西安压根不是长安改的名，"
    },
    {
      "role": "边关",
      "text": "它是新朝廷写给西北的，"
    },
    {
      "role": "边关",
      "text": "一道安民告示。"
    },
    {
      "role": "边关",
      "text": "讲到这，先麻烦诸位老朋友抬抬手，"
    },
    {
      "role": "边关",
      "text": "把屏幕底下那颗小红心按一下，"
    },
    {
      "role": "边关",
      "text": "就当给咱们这座三千年的老城留个心意，"
    },
    {
      "role": "边关",
      "text": "也让更多爱听老故事的朋友，"
    },
    {
      "role": "边关",
      "text": "把这名字里头的讲究瞧个明白。"
    },
    {
      "role": "形胜",
      "text": "闲话搁一边，接着往下说。"
    },
    {
      "role": "形胜",
      "text": "要论西安这块地方，"
    },
    {
      "role": "形胜",
      "text": "那真是老天爷赏饭吃。"
    },
    {
      "role": "形胜",
      "text": "八百里秦川，沃野千里，"
    },
    {
      "role": "形胜",
      "text": "东有潼关，西有大散关，"
    },
    {
      "role": "形胜",
      "text": "南有武关，北有萧关，"
    },
    {
      "role": "形胜",
      "text": "四面一锁，进可逐鹿中原，"
    },
    {
      "role": "形胜",
      "text": "退可据险自守。"
    },
    {
      "role": "形胜",
      "text": "郑国渠、白渠修起来以后，"
    },
    {
      "role": "形胜",
      "text": "旱涝保收，成了天下头号粮仓。"
    },
    {
      "role": "形胜",
      "text": "强汉能北击匈奴，"
    },
    {
      "role": "形胜",
      "text": "盛唐能万国来朝，"
    },
    {
      "role": "形胜",
      "text": "靠的就是这份底气。"
    },
    {
      "role": "纵深",
      "text": "可这么一块宝地，"
    },
    {
      "role": "纵深",
      "text": "头顶上挂的西安两个字，"
    },
    {
      "role": "纵深",
      "text": "到底啥来头，"
    },
    {
      "role": "纵深",
      "text": "绝大多数人心里没底。"
    },
    {
      "role": "纵深",
      "text": "您再往深里琢磨琢磨："
    },
    {
      "role": "纵深",
      "text": "中华文明的前半段，"
    },
    {
      "role": "纵深",
      "text": "几乎都装在这座城里。"
    },
    {
      "role": "纵深",
      "text": "西周的丰镐二京在这儿，"
    },
    {
      "role": "纵深",
      "text": "秦的咸阳宫阙在这儿，"
    },
    {
      "role": "纵深",
      "text": "汉长安城的未央宫在这儿，"
    },
    {
      "role": "纵深",
      "text": "唐的大明宫，也在这儿。"
    },
    {
      "role": "纵深",
      "text": "十三朝，一千一百年建都史。"
    },
    {
      "role": "今昔",
      "text": "可如今游客到了西安，"
    },
    {
      "role": "今昔",
      "text": "张嘴就是肉夹馍、兵马俑、大唐不夜城，"
    },
    {
      "role": "今昔",
      "text": "你要问他西安这俩字啥意思，"
    },
    {
      "role": "今昔",
      "text": "长安和西安到底啥关系，"
    },
    {
      "role": "今昔",
      "text": "十个里头九个答不上来。"
    },
    {
      "role": "今昔",
      "text": "这座城守了三千年，"
    },
    {
      "role": "今昔",
      "text": "守的是周公制礼作乐的文明源头，"
    },
    {
      "role": "今昔",
      "text": "守的是秦皇汉武开疆拓土的豪气，"
    },
    {
      "role": "今昔",
      "text": "守的是盛唐万国来朝的气度。"
    },
    {
      "role": "今昔",
      "text": "这份家底，"
    },
    {
      "role": "今昔",
      "text": "不能在咱们手里断了线。"
    },
    {
      "role": "今昔",
      "text": "劳您在评论区写下四个字："
    },
    {
      "role": "收尾",
      "text": "长安永安。"
    },
    {
      "role": "收尾",
      "text": "写给这座护了中华文明几千年的老城，"
    },
    {
      "role": "收尾",
      "text": "也写给自己。"
    },
    {
      "role": "收尾",
      "text": "您要是还有自己家乡的老地名，"
    },
    {
      "role": "收尾",
      "text": "想弄明白来龙去脉，"
    },
    {
      "role": "收尾",
      "text": "也请在评论区报个名，"
    },
    {
      "role": "收尾",
      "text": "下回，咱就唠您点的那座城。"
    },
    {
      "role": "收尾",
      "text": "末了多说一句，"
    },
    {
      "role": "收尾",
      "text": "有些老底子里的讲究，"
    },
    {
      "role": "收尾",
      "text": "晚知道一天，根就薄上那么一层。"
    },
    {
      "role": "收尾",
      "text": "一座城，十三朝建都，"
    },
    {
      "role": "收尾",
      "text": "三千年文脉不断，"
    },
    {
      "role": "收尾",
      "text": "硬是把这块土，"
    },
    {
      "role": "收尾",
      "text": "养成了天底下最厚重的一份家底。"
    },
    {
      "role": "收尾",
      "text": "以史为鉴，可以知兴替。"
    },
    {
      "role": "收尾",
      "text": "劳您点个关注，咱们不走散。"
    },
    {
      "role": "收尾",
      "text": "下回接着给您唠，您点的那座城。"
    }
  ]
}