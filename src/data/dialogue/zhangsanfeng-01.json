  "lines": [
    { "role": "开场", "text": "《明史》里，记着一桩怪事。" },
    { "role": "开场", "text": "两个皇帝，花了十几年，找一个人，没找到。" },
    { "role": "开场", "text": "这人不是神仙。" },
    { "role": "开场", "text": "是个光脚、破衣、头发乱糟糟的老道士。" },
    { "role": "开场", "text": "他叫张三丰。" },
    { "role": "开场", "text": "问题来了。" },
    { "role": "开场", "text": "皇帝坐拥天下，为什么找不到一个要饭的？" },
    { "role": "开场", "text": "这里面，藏着一个很有意思的问题。" },
    { "role": "层次", "text": "先说明白一件事。" },
    { "role": "层次", "text": "我们今天知道的张三丰，多半是「接受的历史」。" },
    { "role": "层次", "text": "活了几百岁、太极拳祖师、神仙下凡。" },
    { "role": "层次", "text": "可《明史·方伎传》里记的张三丰，是个人。" },
    { "role": "层次", "text": "辽东懿州人，就是今天辽宁阜新。" },
    { "role": "层次", "text": "少年得志，十几岁就管一个县。" },
    { "role": "层次", "text": "这个人，不是生来就放下的。" },
    { "role": "层次", "text": "恰恰相反，他什么都有过。" },
    { "role": "翻转", "text": "他为什么辞官？" },
    { "role": "翻转", "text": "父母走了。" },
    { "role": "翻转", "text": "那个给你鼓掌的人，没了。" },
    { "role": "翻转", "text": "张三丰辞官，应不应该？" },
    { "role": "翻转", "text": "按常理，不应该，年少得志，前途正好。" },
    { "role": "翻转", "text": "我的看法是：他辞的不是官。" },
    { "role": "翻转", "text": "是「活给别人看」。" },
    { "role": "翻转", "text": "父母在，他活给父母看。" },
    { "role": "翻转", "text": "父母走，他不知道活给谁看。" },
    { "role": "翻转", "text": "那就，活给自己看一回。" },
    { "role": "三十年", "text": "他那些同僚，接着干，升官的升官。" },
    { "role": "三十年", "text": "张三丰一个人，在荒山野岭，走了整整三十年。" },
    { "role": "三十年", "text": "不是三个月，是三十年。" },
    { "role": "三十年", "text": "他找什么？" },
    { "role": "三十年", "text": "找一个能告诉他，这辈子该怎么活的人。" },
    { "role": "三十年", "text": "砍柴的老头问他，去哪儿？" },
    { "role": "三十年", "text": "他说：我也不知道，就是不该再待在那儿了。" },
    { "role": "三十年", "text": "这话，他那些升官的同僚，讲不出来。" },
    { "role": "武当山", "text": "六十七岁，终南山，他遇到火龙真人。" },
    { "role": "武当山", "text": "这是道教传说，正史不载。" },
    { "role": "武当山", "text": "正史记的，是另一件事。" },
    { "role": "武当山", "text": "武当山。" },
    { "role": "武当山", "text": "张三丰搭个草棚，住了九年。" },
    { "role": "武当山", "text": "说：这座山，日后名扬天下。" },
    { "role": "武当山", "text": "几十年后，明成祖朱棣。" },
    { "role": "武当山", "text": "花十四年，三十万人。" },
    { "role": "武当山", "text": "把武当山修成了皇家道场。" },
    { "role": "武当山", "text": "张三丰的草棚，就是今天的玉虚宫。" },
    { "role": "传说", "text": "还有个传说。" },
    { "role": "传说", "text": "宝鸡金台观，他「死」了一回。" },
    { "role": "传说", "text": "棺材要盖盖时，又坐了起来。" },
    { "role": "传说", "text": "这不是正史，是民间传说。" },
    { "role": "传说", "text": "学者说，可能是极深的入定。" },
    { "role": "传说", "text": "但有一层意思，是真的。" },
    { "role": "传说", "text": "一个「死过一回」的人，看世界的眼神，不一样了。" },
    { "role": "传说", "text": "生死之外，全是小事。" },
    { "role": "翻案", "text": "现在，回到开头那个问题。" },
    { "role": "翻案", "text": "两个皇帝，为什么找不到他？" },
    { "role": "翻案", "text": "朱元璋找过他，朱棣也找过他。" },
    { "role": "翻案", "text": "皇帝要找的，是长生。" },
    { "role": "翻案", "text": "是再多活几年，江山再坐稳一点。" },
    { "role": "翻案", "text": "张三丰有的，是放下。" },
    { "role": "翻案", "text": "一个求「得到」，一个求「放下」。" },
    { "role": "翻案", "text": "方向相反，怎么碰得上？" },
    { "role": "翻案", "text": "你要找一个人的本事，追得着。" },
    { "role": "翻案", "text": "你要的东西他压根没有，怎么找？" },
    { "role": "人生", "text": "人这一辈子，大半的委屈，不是没得到。" },
    { "role": "人生", "text": "是得到了以后，发现没人替你高兴。" },
    { "role": "人生", "text": "你自己，也没那么高兴。" },
    { "role": "人生", "text": "反倒是小时候，夏天啃根冰棍。" },
    { "role": "人生", "text": "在院子里疯跑的那个下午。" },
    { "role": "人生", "text": "什么都没有，却什么都不缺。" },
    { "role": "人生", "text": "张三丰看透的，就是这个理。" },
    { "role": "金句", "text": "老子说：知足不辱，知止不殆。" },
    { "role": "金句", "text": "知道什么时候该停的人，不会栽跟头。" },
    { "role": "金句", "text": "这话谁都会背。" },
    { "role": "金句", "text": "做到的一千个人里，挑不出一个。" },
    { "role": "金句", "text": "放下的，不该是奋斗，是执念。" },
    { "role": "金句", "text": "不该是责任，是那个「活给别人看」的假自己。" },
    { "role": "收尾", "text": "晚年，张三丰云游到南京。" },
    { "role": "收尾", "text": "见了一个全天下最有钱的人。" },
    { "role": "收尾", "text": "留了句话：你的灾还没完，将来西南再见。" },
    { "role": "收尾", "text": "这人是谁？后来遭了什么难？" },
    { "role": "收尾", "text": "下回，接着讲。" },
    { "role": "收尾", "text": "今天这段，您听到心里去了。" },
    { "role": "收尾", "text": "评论区，打四个字：活明白了。" }
  ]
}
