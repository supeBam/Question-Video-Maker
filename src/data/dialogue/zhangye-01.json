  "lines": [
    {"role": "开场", "text": "中国所有的古城里。"},
    {"role": "开场", "text": "只有一座城，真正决定了，我们汉民族的生存空间。"},
    {"role": "开场", "text": "如果没有这座城。"},
    {"role": "开场", "text": "中国可能永远，只是一个蜷缩在黄河边的小国。"},
    {"role": "开场", "text": "这座城，不在西安，不在洛阳。"},
    {"role": "开场", "text": "它在西北的大漠边上。"},
    {"role": "开场", "text": "它叫张掖。"},

    {"role": "困局", "text": "两千多年前，汉朝刚立国。"},
    {"role": "困局", "text": "北边的匈奴，骑兵几十万。"},
    {"role": "困局", "text": "一来，就是黑压压一片。"},
    {"role": "困局", "text": "高祖皇帝，被围在白登山，七天七夜。"},
    {"role": "困局", "text": "差一点，就回不来了。"},
    {"role": "困局", "text": "从那以后，汉朝只能低头。"},
    {"role": "困局", "text": "送公主，送丝绸，送粮食。"},
    {"role": "困局", "text": "换来的，是匈奴今天答应，明天又来抢。"},
    {"role": "困局", "text": "这个局，整整忍了六十多年。"},

    {"role": "走廊", "text": "转机，出在一张地图上。"},
    {"role": "走廊", "text": "在甘肃，有一条窄窄的通道。"},
    {"role": "走廊", "text": "南边是祁连山，北边是大沙漠。"},
    {"role": "走廊", "text": "中间一条走廊，一千多公里。"},
    {"role": "走廊", "text": "水草好，能养马，能种地。"},
    {"role": "走廊", "text": "谁握住它，谁就握住了西域的大门。"},
    {"role": "走廊", "text": "匈奴握着它，就能从西边，掐住汉朝的脖子。"},
    {"role": "走廊", "text": "这条走廊，叫河西走廊。"},

    {"role": "张骞", "text": "这条路，最早是谁踩出来的。"},
    {"role": "张骞", "text": "一个叫张骞的人。"},
    {"role": "张骞", "text": "汉武帝派他出使西域。"},
    {"role": "张骞", "text": "半路上，被匈奴抓了。"},
    {"role": "张骞", "text": "一关，就是十多年。"},
    {"role": "张骞", "text": "匈奴给他娶了媳妇，生了娃。"},
    {"role": "张骞", "text": "可他手里那根汉节，一直没扔。"},
    {"role": "张骞", "text": "后来他逃出来，继续往西走。"},
    {"role": "张骞", "text": "回到长安的时候，带回了整个西域的地图。"},
    {"role": "张骞", "text": "汉武帝这才看清，西边，还有一个大世界。"},

    {"role": "霍去病", "text": "真正打破这个局的，是一个年轻人。"},
    {"role": "霍去病", "text": "他叫霍去病。"},
    {"role": "霍去病", "text": "十八岁那年，第一次上战场。"},
    {"role": "霍去病", "text": "只带八百个骑兵，就敢冲进大漠深处。"},
    {"role": "霍去病", "text": "一战，封了冠军侯。"},
    {"role": "霍去病", "text": "十九岁，他两次打进河西走廊。"},
    {"role": "霍去病", "text": "春天一次，夏天又一次。"},
    {"role": "霍去病", "text": "匈奴的王，投降的投降，逃跑的逃跑。"},
    {"role": "霍去病", "text": "史书上写，这两仗，汉军斩获四万多。"},
    {"role": "霍去病", "text": "河西走廊，从此换了主人。"},

    {"role": "悲歌", "text": "匈奴人丢了河西，有多疼。"},
    {"role": "悲歌", "text": "他们留下一首歌。"},
    {"role": "悲歌", "text": "丢了焉支山，嫁出去的姑娘，脸上没了胭脂。"},
    {"role": "悲歌", "text": "丢了祁连山，牛羊马匹，再也没处养。"},
    {"role": "悲歌", "text": "焉支山上，产一种草，能做成胭脂。"},
    {"role": "悲歌", "text": "老话讲，胭脂这个词，就是从焉支山来的。"},
    {"role": "悲歌", "text": "一首歌，唱的全是眼泪。"},
    {"role": "悲歌", "text": "可对中原人来说，这首歌，是天亮了。"},

    {"role": "四郡", "text": "拿下河西，汉武帝设了四个郡。"},
    {"role": "四郡", "text": "武威，张掖，酒泉，敦煌。"},
    {"role": "四郡", "text": "武威，是武功军威。"},
    {"role": "四郡", "text": "酒泉，老话讲，是霍去病把御酒倒进泉里，和将士们一起喝。"},
    {"role": "四郡", "text": "那张掖，是什么意思。"},
    {"role": "四郡", "text": "古人注解，张国臂掖，以通西域。"},
    {"role": "四郡", "text": "张，是张开的张。"},
    {"role": "四郡", "text": "张掖的掖，是提手旁，加一个夜。"},
    {"role": "四郡", "text": "张开国家的手臂，把西域，搂进怀里。"},
    {"role": "四郡", "text": "您听听，这名字，起得多大气。"},

    {"role": "丝路", "text": "从那以后，骆驼队，一队接一队。"},
    {"role": "丝路", "text": "中国的丝绸，瓷器，茶叶，往西走。"},
    {"role": "丝路", "text": "西域的葡萄，骏马，香料，往东来。"},
    {"role": "丝路", "text": "佛法，也是顺着这条路，走进中国的。"},
    {"role": "丝路", "text": "张掖，成了路上，最热闹的城。"},
    {"role": "丝路", "text": "各国的商人，使者，僧人。"},
    {"role": "丝路", "text": "在这儿落脚，在这儿交易。"},
    {"role": "丝路", "text": "一座城，连起了，整个东西方。"},

    {"role": "盛会", "text": "一千四百年前，隋炀帝做了一件，惊天动地的事。"},
    {"role": "盛会", "text": "他亲自跑到张掖，摆了一场万国盛会。"},
    {"role": "盛会", "text": "西域二十七国的国王和使者，全来了。"},
    {"role": "盛会", "text": "道路两旁，歌舞不断，一眼望不到头。"},
    {"role": "盛会", "text": "史书上记，那场面，让各国使节，看傻了眼。"},
    {"role": "盛会", "text": "一千四百年前的张掖。"},
    {"role": "盛会", "text": "就是当时世界上，最繁华的都市之一。"},

    {"role": "回扣", "text": "现在，您明白了吗。"},
    {"role": "回扣", "text": "为什么说，张掖决定了，汉民族的生存空间。"},
    {"role": "回扣", "text": "拿下它，汉朝的手臂，伸进了西域。"},
    {"role": "回扣", "text": "疆域，翻了一倍不止。"},
    {"role": "回扣", "text": "丝绸之路，一通了上千年。"},
    {"role": "回扣", "text": "要是没有这座城。"},
    {"role": "回扣", "text": "汉朝的手，伸不出黄河边。"},
    {"role": "回扣", "text": "中国的版图，中国的底气，都要重新写过。"},
    {"role": "回扣", "text": "一座城，真能改变，一个民族的命运。"},

    {"role": "过渡", "text": "其实，像这样的门道，藏在无数的地名里。"},
    {"role": "过渡", "text": "武威什么意思，敦煌什么意思。"},
    {"role": "过渡", "text": "天津为什么叫天津。"},
    {"role": "过渡", "text": "武汉为什么叫武汉。"},
    {"role": "过渡", "text": "这些，都是老祖宗，留给我们的文化常识。"},
    {"role": "过渡", "text": "课本里，讲得少。"},
    {"role": "过渡", "text": "考试里，偏偏爱考。"},
    {"role": "过渡", "text": "生活里，处处用得上。"},

    {"role": "带货", "text": "我给您指条路。"},
    {"role": "带货", "text": "就是这本书，一看就上瘾的中国文化一千问。"},
    {"role": "带货", "text": "它把中国文化里，最该知道的一千个问题。"},
    {"role": "带货", "text": "一问一答，全理明白。"},
    {"role": "带货", "text": "上到朝代更替，地名来历。", "img": "assets/book_1000wen/02_斜放另角度.png"},
    {"role": "带货", "text": "下到民俗节日，诗词歌赋。"},
    {"role": "带货", "text": "今天讲的张掖，武威，敦煌。"},
    {"role": "带货", "text": "书里讲得，比我还细。"},
    {"role": "带货", "text": "小学打底，初中稳分，高中拉差距。"},
    {"role": "带货", "text": "一天十分钟，能用好多年。", "img": "assets/book_1000wen/03_内页翻开.png"},
    {"role": "带货", "text": "自己看，长见识。"},
    {"role": "带货", "text": "给孩子，长学问。"},
    {"role": "带货", "text": "送老人，解闷养心。"},
    {"role": "带货", "text": "想要的朋友，点下方小黄车，进我橱窗挑一挑。"},
    {"role": "带货", "text": "读懂一座城，才能读懂，这个国家。"}
  ]
}
