  "lines": [
    { "role": "开场", "text": "中国历史上，最霸气的一句话，是哪一句？" },
    { "role": "开场", "text": "这个问题，网上吵了几十年。" },
    { "role": "开场", "text": "有人说是，犯强汉者，虽远必诛。" },
    { "role": "开场", "text": "有人说是，王侯将相，宁有种乎。" },
    { "role": "开场", "text": "可您听的这些，多是口口相传的版本。" },
    { "role": "开场", "text": "用我的话讲，是接受的历史。" },
    { "role": "开场", "text": "今天我不按传说的排。" },
    { "role": "开场", "text": "我回到记录的历史，一句一句，重新给您捋。" },
    { "role": "开场", "text": "从第十名，到第一名。" },
    { "role": "开场", "text": "最后那句，我敢说，您想不到。" },

    { "role": "陈汤", "text": "第十名，犯强汉者，虽远必诛。" },
    { "role": "陈汤", "text": "说这话的人，叫陈汤。" },
    { "role": "陈汤", "text": "一个假传圣旨的中级军官。" },
    { "role": "陈汤", "text": "当年匈奴的郅支单于，逃到了中亚。" },
    { "role": "陈汤", "text": "朝廷嫌远，不想追。" },
    { "role": "陈汤", "text": "陈汤不等命令，假借圣旨，带着西域联军，一路追到康居。" },
    { "role": "陈汤", "text": "砍下单于的脑袋。" },
    { "role": "陈汤", "text": "打完，他给皇帝上疏，末尾落下这十个字。" },
    { "role": "陈汤", "text": "假传圣旨，应不应该？" },
    { "role": "陈汤", "text": "我的看法是，该骂，也该谢。" },
    { "role": "陈汤", "text": "骂他欺君，谢他卫国。" },
    { "role": "陈汤", "text": "这话，坐享其成的人，讲不出来。" },

    { "role": "陈胜", "text": "第九名，王侯将相，宁有种乎。" },
    { "role": "陈胜", "text": "说这话的陈胜，是个种地的。" },
    { "role": "陈胜", "text": "两千多年前，他和九百个兄弟，被征去戍边。" },
    { "role": "陈胜", "text": "一场大雨，误了期限。" },
    { "role": "陈胜", "text": "按秦律，误期当斩。" },
    { "role": "陈胜", "text": "左右都是死。" },
    { "role": "陈胜", "text": "陈胜才喊出这句，王侯将相，难道天生就是命好？" },
    { "role": "陈胜", "text": "这一句，不是豪言，是绝境里逼出来的。" },
    { "role": "陈胜", "text": "九百个农民，拿起锄头，就敢跟整个大秦开战。" },
    { "role": "陈胜", "text": "陈胜后来败了。" },
    { "role": "陈胜", "text": "可他点起的那把火，烧掉了一个王朝。" },
    { "role": "陈胜", "text": "也烧出一个道理，没人天生就该跪着。" },

    { "role": "文天祥", "text": "第八名，人生自古谁无死。" },
    { "role": "文天祥", "text": "留取丹心照汗青。" },
    { "role": "文天祥", "text": "文天祥，被押到大都。" },
    { "role": "文天祥", "text": "忽必烈亲自来劝，只要归顺，给他当宰相。" },
    { "role": "文天祥", "text": "文天祥只回两个字，不降。" },
    { "role": "文天祥", "text": "他在牢里写下正气歌。" },
    { "role": "文天祥", "text": "临刑前，朝南方一拜，说，我事毕矣。" },
    { "role": "文天祥", "text": "军队没了，国家亡了，家人散了。" },
    { "role": "文天祥", "text": "只有那口气，从头到尾，没断过。" },
    { "role": "文天祥", "text": "七百年过去，谁读到这十四个字，腰杆都不自觉，挺直几分。" },

    { "role": "顾炎武", "text": "第七名，天下兴亡，匹夫有责。" },
    { "role": "顾炎武", "text": "这八个字，人人都说，是顾炎武讲的。" },
    { "role": "顾炎武", "text": "其实，记录的历史，不是这样。" },
    { "role": "顾炎武", "text": "顾炎武在日知录里，写的是另一句。" },
    { "role": "顾炎武", "text": "是梁启超，把它提炼成今天这八个字。" },
    { "role": "顾炎武", "text": "您看，接受的历史，未必是记录的历史。" },
    { "role": "顾炎武", "text": "这，就是历史最迷人的地方。" },
    { "role": "顾炎武", "text": "至于道理，半点没打折。" },
    { "role": "顾炎武", "text": "国家兴衰，不光是帝王将相的事。" },
    { "role": "顾炎武", "text": "每个普通人，肩上都有份责任。" },
    { "role": "顾炎武", "text": "这话，把国家从皇宫，搬到了街头巷尾。" },

    { "role": "林则徐", "text": "第六名，苟利国家生死以。" },
    { "role": "林则徐", "text": "岂因祸福避趋之。" },
    { "role": "林则徐", "text": "说这话的林则徐，刚被自己朝廷流放。" },
    { "role": "林则徐", "text": "虎门销烟，他得罪了英国人。" },
    { "role": "林则徐", "text": "朝廷为了求和，把他革职，发配新疆伊犁。" },
    { "role": "林则徐", "text": "半路上，他写下这两句。" },
    { "role": "林则徐", "text": "只要对国家有利，命豁出去都行。" },
    { "role": "林则徐", "text": "哪能因为个人祸福，就退缩。" },
    { "role": "林则徐", "text": "一个人，被国家抛弃了，还在替国家操心。" },
    { "role": "林则徐", "text": "您说，这不是英雄，是什么。" },

    { "role": "数风流", "text": "第五名，数风流人物，还看今朝。" },
    { "role": "数风流", "text": "写这词的时候，长征刚走完。" },
    { "role": "数风流", "text": "红军折损大半，前途未卜。" },
    { "role": "数风流", "text": "毛泽东站在黄河边，看漫天大雪。" },
    { "role": "数风流", "text": "他历数秦皇汉武，唐宗宋祖，成吉思汗。" },
    { "role": "数风流", "text": "五位帝王，一笔带过。" },
    { "role": "数风流", "text": "最后落笔，还看今朝。" },
    { "role": "数风流", "text": "在最深的谷底，还望得见最高的山顶。" },
    { "role": "数风流", "text": "这份心气，比这句词，还重。" },

    { "role": "周恩来", "text": "第四名，为中华之崛起而读书。" },
    { "role": "周恩来", "text": "说这话的，是个十二岁的孩子。" },
    { "role": "周恩来", "text": "那年，八国联军刚打进北京。" },
    { "role": "周恩来", "text": "辛丑条约，赔款四亿五千万两白银。" },
    { "role": "周恩来", "text": "人均一两。" },
    { "role": "周恩来", "text": "老师问，你们为什么读书。" },
    { "role": "周恩来", "text": "有说做官的，有说赚钱的。" },
    { "role": "周恩来", "text": "周恩来站起来，就这一句。" },
    { "role": "周恩来", "text": "最屈辱的年月，一个少年，说出最有骨气的话。" },
    { "role": "周恩来", "text": "后来，他用一辈子，兑现了这句话。" },

    { "role": "站起来", "text": "第三名，中国人民，从此站起来了。" },
    { "role": "站起来", "text": "这十个字，朴素得不能再朴素。" },
    { "role": "站起来", "text": "可它前面，是一百零九年的屈辱。" },
    { "role": "站起来", "text": "从鸦片战争起，一千多个不平等条约。" },
    { "role": "站起来", "text": "南京城里，三十万同胞。" },
    { "role": "站起来", "text": "这口气，憋了一百零九年。" },
    { "role": "站起来", "text": "到这一刻，才吐出来。" },
    { "role": "站起来", "text": "一句话，顶一万句。" },

    { "role": "不到长城", "text": "第二名，不到长城，非好汉。" },
    { "role": "不到长城", "text": "这不是在夸长城高。" },
    { "role": "不到长城", "text": "说这话的时候，红军刚翻过六盘山。" },
    { "role": "不到长城", "text": "两万五千里，走下来。" },
    { "role": "不到长城", "text": "从八万多人，走到不足万人。" },
    { "role": "不到长城", "text": "翻雪山，过草地，吃皮带，喝马尿。" },
    { "role": "不到长城", "text": "每一步，都有人倒下。" },
    { "role": "不到长城", "text": "这一句，是说给所有快撑不住的人听的。" },
    { "role": "不到长城", "text": "挺住，终点没到，就不能倒。" },

    { "role": "这一仗", "text": "第一名，这一仗，我们不打，就留给下一代打。" },
    { "role": "这一仗", "text": "一九五零年，美军压到鸭绿江边。" },
    { "role": "这一仗", "text": "新中国，才成立一年，一贫如洗。" },
    { "role": "这一仗", "text": "打，还是不打？" },
    { "role": "这一仗", "text": "谁都知道，打不过。" },
    { "role": "这一仗", "text": "对面有飞机，有坦克，有航母。" },
    { "role": "这一仗", "text": "我们的战士，连棉衣都凑不齐。" },
    { "role": "这一仗", "text": "可还是拍了板，打。" },
    { "role": "这一仗", "text": "零下四十度的长津湖，整连整排的战士，端着枪，冻成了冰雕。" },
    { "role": "这一仗", "text": "十九万多名中国军人，把命，永远留在了那片雪里。" },
    { "role": "这一仗", "text": "这一句，排第一。" },
    { "role": "这一仗", "text": "不是文采，是一个父亲的逻辑。" },
    { "role": "这一仗", "text": "我能扛的苦，绝不留给孩子。" },
    { "role": "这一仗", "text": "前九句，霸气在字。" },
    { "role": "这一仗", "text": "这一句，霸气在骨。" },

    { "role": "常识", "text": "这十句话，为什么能传两千年？" },
    { "role": "常识", "text": "因为它们背后，都站着一个人。" },
    { "role": "常识", "text": "人活了，历史就活了。" },
    { "role": "常识", "text": "可话好记，话背后的常识，您未必知道。" },
    { "role": "常识", "text": "中国这两个字，最早刻在三千年前的何尊上。" },
    { "role": "常识", "text": "写的是，宅兹中国。" },
    { "role": "常识", "text": "蹴鞠，就是今天的足球，战国就有了。" },
    { "role": "常识", "text": "伞，老话讲，是鲁班造的。" },
    { "role": "常识", "text": "风筝，是墨子放的。" },
    { "role": "常识", "text": "我国的国树，是银杏。国花，是牡丹。" },
    { "role": "常识", "text": "国歌的词，是田汉。曲，是聂耳。" },
    { "role": "常识", "text": "五星红旗，是一个叫曾联松的人设计的。" },
    { "role": "常识", "text": "二十四节气，是中国人独有的时间智慧。" },
    { "role": "常识", "text": "弱冠是二十，而立是三十，不惑是四十。" },
    { "role": "常识", "text": "一日不见如隔三秋，三秋，是九个月。" },
    { "role": "常识", "text": "五花八门的五花，指的是五种行当。" },
    { "role": "常识", "text": "这些事，听着小，可都是文化的根。" },
    { "role": "常识", "text": "这些常识，课本里没有，考试却年年考。" },

    { "role": "带货", "text": "我先说句实在话。" },
    { "role": "带货", "text": "看一个孩子有没有见识，不看他报多少班，出过几回国。" },
    { "role": "带货", "text": "看的是，历史有多深，常识有多厚。" },
    { "role": "带货", "text": "差的那几分，攒到一块，就和他想去的学校，擦肩而过。" },
    { "role": "带货", "text": "我给您指条路。" },
    { "role": "带货", "text": "就是这本书，一看就上瘾的中国文化一千问。" },
    { "role": "带货", "text": "它把中国文化里，最该知道的一千个问题，一问一答，全理明白。" },
    { "role": "带货", "text": "上到朝代更替，帝王将相。" },
    { "role": "带货", "text": "下到民俗节日，诗词歌赋。" },
    { "role": "带货", "text": "小学打底，初中稳分，高中拉差距。" },
    { "role": "带货", "text": "一天十分钟，能用好多年。" },
    { "role": "带货", "text": "今天讲的这十句话，书里都掰开揉碎，讲得透透的。" },
    { "role": "带货", "text": "自己看，长见识。" },
    { "role": "带货", "text": "给孩子，长学问。" },
    { "role": "带货", "text": "送老人，解闷养心。" },
    { "role": "带货", "text": "想要的朋友，点下方小黄车，进我橱窗挑一挑。" },
    { "role": "带货", "text": "咱们一边看视频涨知识，一边读书养根。" },
    { "role": "带货", "text": "历史从未走远，它就藏在这一千个问里。" }
  ]
}
